{%- comment -%}
  Botón flotante de WhatsApp de Cotidiano Shoes (esquina inferior derecha, en todas las páginas).
  Se incluye desde layout/theme.liquid. Para cambiar el número o el mensaje, edita las dos líneas de abajo.
{%- endcomment -%}
{%- liquid
  assign wa_numero = '573103081052'
  assign wa_mensaje = 'Hola Cotidiano Shoes, quiero información'
  # En producto y carrito no se muestra: ahí el cliente compra directo en la página
  assign mostrar_wa = true
  if template.name == 'product' or template.name == 'cart'
    assign mostrar_wa = false
  endif
-%}
{%- if mostrar_wa -%}
<a class="cot-wa" href="https://wa.me/{{ wa_numero }}?text={{ wa_mensaje | url_encode }}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16.03 3C9 3 3.3 8.7 3.3 15.72c0 2.25.59 4.44 1.7 6.37L3.2 28.8l6.88-1.8a12.7 12.7 0 0 0 5.95 1.5h.01c7.02 0 12.73-5.7 12.73-12.72C28.77 8.7 23.06 3 16.03 3zm0 23.3h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-4.08 1.07 1.09-3.98-.25-.41a10.54 10.54 0 0 1-1.62-5.65c0-5.84 4.76-10.6 10.61-10.6 2.83 0 5.49 1.1 7.49 3.11a10.53 10.53 0 0 1 3.1 7.5c0 5.84-4.76 10.6-10.6 10.6zm5.81-7.94c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.71.16-.21.32-.82 1.04-1 1.25-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.56-1.58-.95-.85-1.59-1.89-1.77-2.21-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.71-1.71-.98-2.34-.26-.62-.52-.53-.71-.54h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65s1.14 3.08 1.3 3.29c.16.21 2.24 3.42 5.43 4.8.76.33 1.35.52 1.81.67.76.24 1.45.21 2 .13.61-.09 1.89-.77 2.15-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37z"/></svg>
</a>
<style>
  .cot-wa{position:fixed;right:20px;bottom:20px;z-index:9200;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#25D366;color:#fff;box-shadow:0 6px 16px rgba(0,0,0,.2);opacity:.92;transition:transform .2s}
  .cot-wa:hover{transform:scale(1.08)}
  .cot-wa:focus-visible{outline:3px solid #0B63CE;outline-offset:3px}
  .cot-wa svg{width:26px;height:26px}
  @keyframes cotWaPulse{0%{scale:1;opacity:.8}100%{scale:1.5;opacity:0}}
  @media(max-width:900px){.cot-wa{right:12px;bottom:12px;width:44px;height:44px}}
  @media(prefers-reduced-motion:reduce){.cot-wa::after{animation:none;opacity:0}}
  @media print{.cot-wa{display:none}}
</style>
{%- endif -%}
