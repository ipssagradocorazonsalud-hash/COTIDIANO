{%- comment -%}
  COTIDIANO® · Aviso de compra segura debajo del botón de compra (blocks/buy-buttons.liquid).
  Solo datos confirmados por la tienda. Para cambiar el número de WhatsApp: snippets/cotidiano-whatsapp.liquid.
{%- endcomment -%}
{%- liquid
  assign wa = '573103081052'
  assign msg = 'Hola Cotidiano Shoes, tengo una duda con la talla de ' | append: product.title
-%}
<div class="ct-seg" role="note" aria-label="Compra segura">
  <p class="ct-seg-t"><span aria-hidden="true">🛡️</span> Compra 100% segura</p>
  <ul class="ct-seg-l">
    <li><span aria-hidden="true">💵</span><span><b>Paga contra entrega</b> o en línea</span></li>
    <li><span aria-hidden="true">🔒</span><span>Pago protegido por <b>Shopify</b></span></li>
    <li><span aria-hidden="true">🚚</span><span>Despacho <b>el mismo día</b> si pides antes de las 12:00&nbsp;m.</span></li>
    <li><span aria-hidden="true">📦</span><span>Te enviamos la <b>guía de rastreo</b></span></li>
  </ul>
  <a class="ct-seg-wa" href="https://wa.me/{{ wa }}?text={{ msg | url_encode }}" target="_blank" rel="noopener">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.7 3.3 15.7c0 2.3.6 4.4 1.7 6.4L3.2 28.8l6.9-1.8a12.7 12.7 0 0 0 5.9 1.5c7 0 12.7-5.7 12.7-12.7S23 3 16 3zm5.8 15.4c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-.9-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.1 3.1 1.3 3.3c.2.2 2.2 3.4 5.4 4.8 2.7 1.1 3.2.9 3.8.8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
    <span>¿Dudas con tu talla? <b>Escríbenos por WhatsApp</b></span>
  </a>
</div>
<style>
  .ct-seg{margin-top:14px;padding:14px 16px;border:1.5px solid rgba(16,43,32,.2);border-radius:16px;background:#FAF8F1;color:#171916}
  .ct-seg-t{margin:0 0 8px;font-weight:800;font-size:.95rem;color:#102B20}
  .ct-seg-l{list-style:none;margin:0;padding:0;display:grid;gap:6px;font-size:.86rem;line-height:1.35}
  .ct-seg-l li{display:flex;gap:9px;align-items:flex-start}
  .ct-seg-wa{display:flex;align-items:center;gap:10px;margin-top:12px;padding:10px 14px;border-radius:999px;background:#25D366;color:#fff;text-decoration:none;font-size:.88rem;line-height:1.25}
  .ct-seg-wa:hover{filter:brightness(.95)}
  .ct-seg-wa svg{width:22px;height:22px;flex:none}
  .ct-seg-wa:focus-visible{outline:3px solid #D99A27;outline-offset:2px}
</style>
