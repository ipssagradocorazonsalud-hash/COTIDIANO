  .variant-picker .variant-option--buttons .variant-option__button-label{min-width:44px;flex:0 0 auto;padding-block:7px;padding-inline:13px;min-height:0;font-size:.82rem;line-height:1.2;border-radius:999px}
  .variant-picker .variant-option--buttons .variant-option__button-label__text{text-align:center;white-space:nowrap}
  .variant-picker .variant-option--buttons legend{font-size:.82rem;font-weight:600;margin-block-end:8px}
  .variant-picker .variant-option--buttons + .variant-option--buttons,
  .variant-picker .variant-option + .variant-option{margin-block-start:14px}
  @media (max-width:749px){
    .variant-picker .variant-option--buttons .variant-option__button-label{padding-inline:11px;font-size:.78rem}
