{%- comment -%}
  COTIDIANO® · Barra fija de compra segura (parte de abajo de la pantalla, en todas las páginas).
  Se incluye desde layout/theme.liquid. Computador: todos los beneficios + botón de WhatsApp.
  Celular: franja delgada que se desplaza sola (el botón flotante de WhatsApp queda encima).
  Solo datos reales de la tienda. Número de WhatsApp: mismo de snippets/cotidiano-whatsapp.liquid.
{%- endcomment -%}
{%- liquid
  assign wa = '573103081052'
  assign msg = 'Hola Cotidiano Shoes, tengo una duda con mi talla'
  if template.name == 'product' and product
    assign msg = 'Hola Cotidiano Shoes, tengo una duda con la talla de ' | append: product.title
  endif
-%}
{%- capture items -%}
  <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.4 7.5 9.5 4.4-1.1 7.5-4.9 7.5-9.5V6z"/><path d="m8.5 12 2.4 2.4L15.8 9.6"/></svg><span><b>Compra 100% segura</b></span></li>
  <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/></svg><span><b>Paga contra entrega</b> o en línea</span></li>
  <li><svg class="ct-shopify" viewBox="0 0 24 28" aria-hidden="true"><path fill="#95BF47" d="M3 7.5 17.2 5.2l3.3 20.3L4.8 27.5 1.8 9z"/><path fill="#5E8E3E" d="m17.2 5.2 3.3 20.3-4.8 1.1L14.6 5.6z"/><path fill="none" stroke="#95BF47" stroke-width="1.4" d="M7.5 8.3c.2-3.9 1.9-6.4 3.7-6.4 1.9 0 2.8 2.4 3 5.6"/><path fill="#fff" d="M12.9 12.2c-.6-.3-1.4-.5-2.2-.4-1.8.2-2.8 1.4-2.8 2.7.1 2.6 3.8 2.5 3.9 4 0 .7-.6 1.2-1.5 1.2-1.1.1-2-.6-2-.6l-.6 1.8s1 .8 2.7.7c1.9-.1 3.2-1.4 3.1-3.1-.1-2.9-3.8-2.8-3.8-4 0-.4.3-.9 1.3-.9.8 0 1.4.3 1.4.3z"/></svg><span>Pago protegido por <b>Shopify</b></span></li>
  <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span>Despacho <b>el mismo día</b> <small>(antes de las 12:00&nbsp;m.)</small></span></li>
  <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5 11 4l7.5 3.5v8L11 19l-7.5-3.5z"/><path d="M3.5 7.5 11 11l7.5-3.5M11 11v8"/></svg><span>Te enviamos la <b>guía de rastreo</b></span></li>
{%- endcapture -%}
<aside class="ct-seg-bar" aria-label="Compra segura en COTIDIANO">
  <div class="ct-seg-bar-in">
    <ul class="ct-seg-bar-l">{{ items }}</ul>
    <ul class="ct-seg-bar-l ct-seg-bar-dup" aria-hidden="true">{{ items }}</ul>
  </div>
  <a class="ct-seg-bar-wa" href="https://wa.me/{{ wa }}?text={{ msg | url_encode }}" target="_blank" rel="noopener">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.7 3.3 15.7c0 2.3.6 4.4 1.7 6.4L3.2 28.8l6.9-1.8a12.7 12.7 0 0 0 5.9 1.5c7 0 12.7-5.7 12.7-12.7S23 3 16 3zm5.8 15.4c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-.9-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.1 3.1 1.3 3.3c.2.2 2.2 3.4 5.4 4.8 2.7 1.1 3.2.9 3.8.8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
    <span><b>¿Dudas con tu talla?</b><small>Escríbenos por WhatsApp</small></span><i aria-hidden="true">→</i>
  </a>
</aside>
<style>
  :root{--ct-seg-h:64px}
  body{padding-bottom:var(--ct-seg-h)}
  .ct-seg-bar{position:fixed;left:0;right:0;bottom:0;z-index:90;height:var(--ct-seg-h);display:flex;align-items:center;gap:18px;padding:0 20px;background:#F2E6CF;color:#171916;border-top:2px solid #102B20;box-shadow:0 -8px 24px rgba(16,43,32,.12);font-size:.84rem;line-height:1.2}
  .ct-seg-bar-in{flex:1;min-width:0;overflow:hidden;display:flex}
  .ct-seg-bar-l{list-style:none;margin:0;padding:0;display:flex;align-items:center;flex:1;justify-content:space-around}
  .ct-seg-bar-l li{display:flex;align-items:center;gap:9px;padding:0 14px;white-space:nowrap}
  .ct-seg-bar-l li+li{border-left:1px solid rgba(16,43,32,.22)}
  .ct-seg-bar-l svg{width:24px;height:24px;flex:none;fill:none;stroke:#102B20;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .ct-seg-bar-l svg.ct-shopify{stroke:none;width:22px;height:26px}
  .ct-seg-bar-l small{font-size:.72rem;color:#4E5A4F}
  .ct-seg-bar-dup{display:none}
  .ct-seg-bar-wa{flex:none;display:flex;align-items:center;gap:10px;padding:8px 18px 8px 12px;border-radius:999px;background:#1E7B3C;color:#fff;text-decoration:none;box-shadow:0 6px 16px rgba(30,123,60,.3)}
  .ct-seg-bar-wa:hover{background:#196a33}
  .ct-seg-bar-wa svg{width:28px;height:28px}
  .ct-seg-bar-wa span{display:flex;flex-direction:column;line-height:1.15}
  .ct-seg-bar-wa small{font-size:.74rem;opacity:.9}
  .ct-seg-bar-wa i{font-style:normal;font-size:1.1rem}
  .ct-seg-bar a:focus-visible{outline:3px solid #D99A27;outline-offset:2px}
  /* El botón flotante de WhatsApp: en computador lo reemplaza el de la barra; en celular queda encima de la barra */
  @media (min-width:1101px){.cot-wa{display:none!important}}
  @media (max-width:1100px){
    :root{--ct-seg-h:42px}
    .ct-seg-bar{padding:0;font-size:.78rem}
    .ct-seg-bar-wa{display:none}
    .ct-seg-bar-in{width:100%}
    .ct-seg-bar-l{flex:none;justify-content:flex-start;animation:ctSegBar 26s linear infinite}
    .ct-seg-bar-dup{display:flex}
    .ct-seg-bar-l svg{width:19px;height:19px}
    @keyframes ctSegBar{to{transform:translateX(-100%)}}
    .cot-wa{bottom:calc(var(--ct-seg-h) + 12px)!important}
  }
  @media (prefers-reduced-motion:reduce){.ct-seg-bar-l{animation:none}}
  @media print{.ct-seg-bar{display:none}}
</style>
