{%- comment -%}
  COTIDIANO® · Pie de página retro (grupo sections/footer-group.json).
  Solo datos reales: redes, correo y WhatsApp vienen de los ajustes; las políticas son las que
  la tienda tenga publicadas en Shopify (si una no existe, no se muestra).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign wa = s.whatsapp | remove: '+' | remove: ' '
  assign marcas = 'adidas:Adidas,nike:Nike,new-balance:New Balance,on:On Running,salomon:Salomon,ugg:UGG,timberland:Timberland' | split: ','
-%}
<footer class="rt rt-ft">
  <div class="rt-wrap rt-ft-grid">
    <div class="rt-ft-brand">
      <a class="rt-ft-logo" href="{{ routes.root_url }}">
        {%- if settings.logo -%}
          {{ settings.logo | image_url: width: 360 | image_tag: alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <span class="rt-serif">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if s.texto != blank -%}<p class="rt-ft-p">{{ s.texto | escape }}</p>{%- endif -%}
      <ul class="rt-ft-soc" aria-label="Redes sociales">
        {%- if s.instagram != blank -%}
          <li><a href="{{ s.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor"/></svg></a></li>
        {%- endif -%}
        {%- if s.facebook != blank -%}
          <li><a href="{{ s.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg></a></li>
        {%- endif -%}
        {%- if wa != blank -%}
          <li><a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.7 3.3 15.7c0 2.3.6 4.4 1.7 6.4L3.2 28.8l6.9-1.8a12.7 12.7 0 0 0 5.9 1.5c7 0 12.7-5.7 12.7-12.7S23 3 16 3zm0 23.3c-1.9 0-3.8-.5-5.4-1.5l-.4-.2-4.1 1.1 1.1-4-.3-.4a10.5 10.5 0 0 1-1.6-5.6C5.3 9.8 10.1 5 16 5s10.6 4.8 10.6 10.7S21.9 26.3 16 26.3zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-.9-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.1 3.1 1.3 3.3c.2.2 2.2 3.4 5.4 4.8 2.7 1.1 3.2.9 3.8.8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg></a></li>
        {%- endif -%}
      </ul>
    </div>

    <nav class="rt-ft-col" aria-labelledby="rtFt1">
      <h2 id="rtFt1">Comprar</h2>
      <ul>
        <li><a href="/collections/hombre">Hombre</a></li>
        <li><a href="/collections/mujer">Mujer</a></li>
        <li><a href="/collections/all?sort_by=created-descending">Novedades</a></li>
        <li><a href="/collections/ofertas">Ofertas</a></li>
      </ul>
    </nav>

    <nav class="rt-ft-col" aria-labelledby="rtFt2">
      <h2 id="rtFt2">Marcas</h2>
      <ul>
        {%- for m in marcas -%}
          {%- assign par = m | split: ':' -%}
          {%- assign col = collections[par[0]] -%}
          {%- if col.id -%}<li><a href="{{ col.url }}">{{ par[1] }}</a></li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <nav class="rt-ft-col" aria-labelledby="rtFt3">
      <h2 id="rtFt3">Ayuda</h2>
      <ul>
        {%- if wa != blank -%}<li><a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">WhatsApp</a></li>{%- endif -%}
        {%- if s.correo != blank -%}<li><a href="mailto:{{ s.correo }}">{{ s.correo }}</a></li>{%- endif -%}
        <li><a href="{{ routes.account_url }}">Mi cuenta</a></li>
        {%- for p in shop.policies -%}
          <li><a href="{{ p.url }}">{{ p.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>

  <div class="rt-ft-bot">
    <div class="rt-wrap rt-ft-bot-in">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="rt-ft-pay" aria-label="Medios de pago">
          {%- for t in shop.enabled_payment_types -%}<li>{{ t | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página retro",
  "settings": [
    { "type": "textarea", "id": "texto", "label": "Texto corto", "default": "Tienda multimarca de zapatillas en Colombia." },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "text", "id": "correo", "label": "Correo de contacto", "default": "cotidianoshoes@hotmail.com" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (con indicativo)", "default": "573103081052" }
  ],
  "presets": [{ "name": "Pie de página retro" }]
}
{% endschema %}
