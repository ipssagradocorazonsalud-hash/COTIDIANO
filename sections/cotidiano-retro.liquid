{%- comment -%}
  COTIDIANO® · Inicio retro (Vintage Sports Club).
  Orden: hero · Universo de Marcas · Hombre y Mujer · producto protagonista (compra real) · beneficios ·
  más buscados · cierre con suscripción (formulario de clientes de Shopify).
  Imágenes por defecto: archivos del tema (assets/rt-*.webp); cada una se puede reemplazar desde el editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign marcas = section.blocks | where: 'type', 'marca'
  assign colecciones = section.blocks | where: 'type', 'coleccion'
  assign destacados = section.blocks | where: 'type', 'destacado'
  assign beneficios = section.blocks | where: 'type', 'beneficio'
  assign pp = s.producto
  if pp == blank
    assign pp = all_products['salomon-xt-6']
  endif
  assign mcol = s.mas_coleccion | default: collections.all
  assign wa = s.whatsapp | remove: '+' | remove: ' '
-%}

<div class="rt">
  {%- comment -%} 1 · Hero {%- endcomment -%}
  <section class="rt-hero rt-rev" aria-label="COTIDIANO, ofertas en tus marcas favoritas">
    <h1 class="rt-sr">{{ s.hero_titulo | escape }}</h1>
    <a class="rt-hero-a" href="{{ s.hero_enlace | default: routes.all_products_collection_url }}" aria-label="{{ s.hero_boton | escape }}">
      {%- if s.hero_imagen -%}
        {{ s.hero_imagen | image_url: width: 2000 | image_tag: alt: s.hero_titulo, loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000', sizes: '100vw', class: 'rt-hero-img' }}
      {%- else -%}
        <img class="rt-hero-img" src="{{ 'rt-hero.webp' | asset_url }}" srcset="{{ 'rt-hero-800.webp' | asset_url }} 800w, {{ 'rt-hero.webp' | asset_url }} 1670w" sizes="100vw" alt="{{ s.hero_titulo | escape }}" width="1670" height="941" fetchpriority="high" decoding="async">
      {%- endif -%}
      <span class="rt-hero-cta">{{ s.hero_boton | escape }} <span aria-hidden="true">→</span></span>
      <span class="rt-hero-cta-m" aria-hidden="true">{{ s.hero_boton | escape }} →</span>
    </a>
  </section>

  {%- comment -%} 2 · Universo de Marcas {%- endcomment -%}
  {%- if marcas.size > 0 -%}
    <section class="rt-uni rt-rev" aria-labelledby="rtUni">
      <div class="rt-wrap">
        <p class="rt-kicker"><span>{{ s.uni_kicker | escape }}</span></p>
        <h2 class="rt-h2 rt-serif" id="rtUni">{{ s.uni_titulo | escape }}</h2>
        <p class="rt-sub">{{ s.uni_sub | escape }}</p>
        <ul class="rt-uni-grid rt-uni-v">
          {%- for b in marcas -%}
            {%- liquid
              assign bh = b.settings.handle | strip | downcase
              assign url = b.settings.enlace
              if url == blank
                assign ch = bh
                if bh == 'on-running'
                  assign ch = 'on'
                endif
                assign col = collections[ch]
                if col.id
                  assign url = col.url
                else
                  assign url = routes.all_products_collection_url
                endif
              endif
            -%}
            <li {{ b.shopify_attributes }}>
              <a class="rt-uni-card" href="{{ url }}">
                {%- if b.settings.imagen -%}
                  {{ b.settings.imagen | image_url: width: 640 | image_tag: alt: b.settings.nombre, loading: 'lazy', widths: '320, 480, 640', sizes: '(max-width: 700px) 46vw, 200px' }}
                {%- else -%}
                  <img src="{{ b.settings.imagen_tema | asset_url }}" alt="Explorar {{ b.settings.nombre | escape }}" loading="lazy" width="460" height="1200">
                {%- endif -%}
                <span class="rt-sr">Explorar {{ b.settings.nombre | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 2b · Más buscados (entre el Universo de Marcas y los pares destacados) {%- endcomment -%}
  <section class="rt-mb rt-wrap rt-rev" aria-labelledby="rtMb">
    <div class="rt-mb-head">
      <h2 class="rt-h3 rt-serif" id="rtMb">{{ s.mas_titulo | escape }}</h2>
      <hr aria-hidden="true">
      <a href="{{ mcol.url | default: routes.all_products_collection_url }}">Ver colección →</a>
    </div>
    <div class="rt-car">
      <button type="button" class="rt-arr rt-arr-p" aria-label="Anteriores" data-rt="-1">←</button>
      <div class="rt-track" id="rtTrack">
        {%- if s.mas_lista != blank -%}
          {%- assign lineas = s.mas_lista | newline_to_br | split: '<br />' -%}
          {%- for l in lineas -%}
            {%- assign partes = l | strip | split: '|' -%}
            {%- assign h = partes[0] | strip -%}
            {%- assign c = partes[1] | strip -%}
            {%- assign p = all_products[h] -%}
            {%- if p.id -%}{%- render 'cotidiano-mb-tarjeta', p: p, col: c -%}{%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for p in mcol.products limit: 12 -%}{%- render 'cotidiano-mb-tarjeta', p: p, col: '' -%}{%- endfor -%}
        {%- endif -%}
      </div>
      <button type="button" class="rt-arr rt-arr-n" aria-label="Siguientes" data-rt="1">→</button>
    </div>
  </section>

  {%- comment -%} 3 · Pares destacados (fotos reales de producto, sin retoque de color) {%- endcomment -%}
  {%- if destacados.size > 0 -%}
    <section class="rt-dest rt-wrap rt-rev" aria-label="Pares destacados">
      {%- for b in destacados -%}
        {%- liquid
          assign bs = b.settings
          assign p = bs.producto
          assign url = p.url | default: routes.all_products_collection_url
        -%}
        <a class="rt-dest-card" href="{{ url }}" style="--fondo:{{ bs.fondo }};--raya:{{ bs.raya }}" {{ b.shopify_attributes }}>
          <span class="rt-dest-rayas" aria-hidden="true"></span>
          <span class="rt-dest-txt">
            {%- if bs.logo_tema != blank -%}
              <img class="rt-dest-logo" src="{{ bs.logo_tema | asset_url }}" alt="{{ bs.marca | escape }}" loading="lazy" height="80">
            {%- elsif bs.marca != blank -%}
              <span class="rt-dest-marca">{{ bs.marca | escape }}</span>
            {%- endif -%}
            <span class="rt-dest-t rt-serif">{{ bs.titulo | escape }}</span>
            <span class="rt-dest-linea" aria-hidden="true"></span>
            <span class="rt-dest-k">{{ bs.kicker | escape }}</span>
            {%- if p -%}<span class="rt-dest-pr">{{ p.price | money_without_trailing_zeros }}{% if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}</span>{%- endif -%}
            <span class="rt-btn rt-btn-sm">Ver producto <span aria-hidden="true">→</span></span>
          </span>
          <span class="rt-dest-img">
            {%- if bs.imagen -%}
              {{ bs.imagen | image_url: width: 900 | image_tag: alt: p.title, loading: 'lazy', widths: '450, 700, 900', sizes: '(max-width: 900px) 70vw, 25vw' }}
            {%- elsif bs.imagen_tema != blank -%}
              <img src="{{ bs.imagen_tema | asset_url }}" alt="{{ p.title | escape }}" loading="lazy" width="900" height="600">
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </section>
  {%- endif -%}

  {%- comment -%} 3 · Hombre y Mujer {%- endcomment -%}
  {%- if colecciones.size > 0 -%}
    <section class="rt-hm rt-wrap rt-rev" aria-label="Colecciones">
      {%- for b in colecciones -%}
        {%- assign c = b.settings.coleccion -%}
        <a class="rt-hm-card rt-hm-c{{ forloop.index }}" href="{{ c.url | default: routes.all_products_collection_url }}" {{ b.shopify_attributes }}>
          {%- if b.settings.imagen -%}{{ b.settings.imagen | image_url: width: 1200 | image_tag: alt: '', loading: 'lazy', widths: '600, 900, 1200', sizes: '(max-width: 700px) 100vw, 50vw' }}{%- endif -%}
          <span class="rt-hm-txt">
            <span class="rt-hm-k">Colección</span>
            <span class="rt-hm-t rt-serif">{{ b.settings.titulo | escape }}</span>
            {%- if c -%}<span class="rt-hm-n">{{ c.products_count }} modelos</span>{%- endif -%}
            <span class="rt-btn rt-btn-sm">Ver colección <span aria-hidden="true">→</span></span>
          </span>
        </a>
      {%- endfor -%}
    </section>
  {%- endif -%}

  {%- comment -%} 4 · Producto protagonista (datos reales de Shopify) {%- endcomment -%}
  {%- if pp != blank and pp.available -%}
    {%- liquid
      assign copt = 0
      assign topt = 1
      for o in pp.options_with_values
        assign on = o.name | downcase
        if on contains 'color'
          assign copt = forloop.index
        endif
        if on contains 'talla' or on contains 'size'
          assign topt = forloop.index
        endif
      endfor
    -%}
    <section class="rt-pp rt-rev" aria-label="Producto protagonista: {{ pp.title | escape }}" id="rtPp-sec">
      <div class="rt-wrap rt-pp-in">
        <a class="rt-pp-img" href="{{ pp.url }}" aria-label="Ver {{ pp.title | escape }}">
          {%- if s.pp_imagen -%}
            {{ s.pp_imagen | image_url: width: 1600 | image_tag: alt: '', loading: 'lazy', widths: '800, 1200, 1600', sizes: '(max-width: 1100px) 100vw, 1100px' }}
          {%- else -%}
            <img src="{{ 'rt-xt6.webp' | asset_url }}" alt="" loading="lazy" width="1672" height="941">
          {%- endif -%}
        </a>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 5 · Beneficios {%- endcomment -%}
  {%- if beneficios.size > 0 -%}
    <section class="rt-ben rt-rev" aria-label="Beneficios de comprar en COTIDIANO">
      <ul class="rt-wrap rt-ben-list">
        {%- for b in beneficios -%}
          <li {{ b.shopify_attributes }}>
            {%- render 'cotidiano-retro-icono', icono: b.settings.icono -%}
            <b>{{ b.settings.titulo | escape }}</b>
            {%- if b.settings.texto != blank -%}<span>{{ b.settings.texto | escape }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

  {%- comment -%} 7 · Cierre: comunidad + suscripción (clientes de Shopify con etiqueta newsletter) {%- endcomment -%}
  <section class="rt-com rt-rev" aria-labelledby="rtCom">
    <div class="rt-com-in">
      <div class="rt-com-img">
        {%- if s.com_imagen -%}
          {{ s.com_imagen | image_url: width: 1200 | image_tag: alt: 'Tienda COTIDIANO', loading: 'lazy', widths: '600, 900, 1200', sizes: '(max-width: 900px) 100vw, 50vw' }}
        {%- else -%}
          <img src="{{ 'rt-tienda.webp' | asset_url }}" alt="Fachada de la tienda COTIDIANO" loading="lazy" width="1000" height="667">
        {%- endif -%}
      </div>
      <div class="rt-com-txt">
        <h2 class="rt-serif" id="rtCom"><span class="rt-com-k">{{ s.com_titulo | escape }}</span> <span class="rt-com-m">COTIDIANO<sup>®</sup></span></h2>
        <p>{{ s.com_texto | escape }}</p>
        {%- form 'customer', id: 'rtNews', class: 'rt-news' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="rt-news-ok" role="status">¡Listo! Ya haces parte de la comunidad COTIDIANO.</p>
          {%- else -%}
            <label class="rt-sr" for="rtNewsEmail">Correo electrónico</label>
            <span class="rt-news-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            <input id="rtNewsEmail" type="email" name="contact[email]" placeholder="Ingresa tu correo" autocomplete="email" required>
            <button type="submit" class="rt-btn rt-btn-dark">Suscribirme <span aria-hidden="true">→</span></button>
            {%- if form.errors -%}<p class="rt-news-err" role="alert">{{ form.errors.translated_fields.email | default: 'Correo' }} {{ form.errors.messages.email }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>
</div>

<script>
(function(){
  /* Aparición progresiva de las secciones */
  var rv=[].slice.call(document.querySelectorAll('.rt-rev'));
  if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12});
    rv.forEach(function(el){el.classList.add('rt-pre');io.observe(el);});
  }
  /* Carrusel Más buscados */
  var tr=document.getElementById('rtTrack');
  if(tr)document.querySelectorAll('[data-rt]').forEach(function(b){b.addEventListener('click',function(){tr.scrollBy({left:+b.dataset.rt*tr.clientWidth*.9,behavior:'smooth'});});});
  /* Producto protagonista: color → tallas → agregar al carrito (variantes reales) */
  var box=document.getElementById('rtPp'),dataEl=document.getElementById('rtPpData');
  if(!box||!dataEl)return;
  var D;try{D=JSON.parse(dataEl.textContent);}catch(e){return;}
  var ci=D.copt-1,ti=D.topt-1,col=null,sel=null;
  function esc(t){return String(t).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  var cols=[];if(ci>=0)D.v.forEach(function(v){if(cols.indexOf(v.o[ci])<0)cols.push(v.o[ci]);});
  var ini=box.dataset.colorIni;
  col=ci>=0?(cols.indexOf(ini)>=0?ini:(cols.filter(function(c){return D.v.some(function(v){return v.o[ci]===c&&v.a;});})[0]||cols[0])):null;
  var elC=document.getElementById('rtPpCols'),elN=document.getElementById('rtPpColN'),elS=document.getElementById('rtPpSizes'),elSt=document.getElementById('rtPpStock'),btn=document.getElementById('rtPpAdd'),elP=document.getElementById('rtPpPrice'),elCmp=document.getElementById('rtPpCmp');
  function pintar(){
    if(elC){elC.innerHTML=cols.map(function(c){var hay=D.v.some(function(v){return v.o[ci]===c&&v.a;});return '<button type="button" class="rt-chip" data-c="'+esc(c)+'" aria-pressed="'+(c===col)+'"'+(hay?'':' data-agotado')+'>'+esc(c)+'</button>';}).join('');elN.textContent=col;}
    var vs=D.v.filter(function(v){return ci<0||v.o[ci]===col;});
    vs.sort(function(a,b){return parseFloat(a.o[ti])-parseFloat(b.o[ti]);});
    elS.innerHTML=vs.map(function(v){return '<button type="button" class="rt-chip rt-chip-t" data-id="'+v.id+'" aria-pressed="'+(sel&&sel.id===v.id)+'"'+(v.a?'':' disabled aria-label="Talla '+esc(v.o[ti])+' agotada"')+'>'+esc(v.o[ti])+'</button>';}).join('');
    var ref=sel||vs[0];if(ref){elP.textContent=ref.p;elCmp.textContent=ref.c||'';}
    var disp=vs.filter(function(v){return v.a;}).length;
    elSt.textContent=sel?(sel.q!==null&&sel.q<=3?'¡Últimas '+sel.q+' unidades en talla '+sel.o[ti]+'!':'Disponible en talla '+sel.o[ti]):(disp?'Disponible en '+disp+' tallas':'Agotado en este color');
    btn.disabled=!sel;btn.textContent=sel?'Agregar al carrito':'Elige tu talla';
  }
  box.addEventListener('click',function(e){
    var c=e.target.closest('[data-c]');if(c){col=c.dataset.c;sel=null;pintar();return;}
    var t=e.target.closest('[data-id]');if(t&&!t.disabled){sel=D.v.filter(function(v){return String(v.id)===t.dataset.id;})[0];pintar();}
  });
  btn.addEventListener('click',function(){
    if(!sel)return;btn.disabled=true;btn.textContent='Agregando…';
    fetch((window.Shopify&&Shopify.routes?Shopify.routes.root:'/')+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:sel.id,quantity:1}]})})
      .then(function(r){if(!r.ok)throw r;return r.json();})
      .then(function(){btn.textContent='¡Agregado! Ver carrito →';btn.disabled=false;btn.onclick=function(){location.href='/cart';};document.dispatchEvent(new CustomEvent('cart:refresh'));})
      .catch(function(){btn.textContent='No se pudo agregar, intenta de nuevo';btn.disabled=false;});
  });
  pintar();
})();
</script>

{% schema %}
{
  "name": "COTIDIANO · Inicio retro",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_imagen", "label": "Imagen del hero", "info": "Vacía = diseño COTIDIANO con las zapatillas y el televisor retro." },
    { "type": "text", "id": "hero_titulo", "label": "Título (para buscadores)", "default": "COTIDIANO, tienda multimarca de zapatillas en Colombia" },
    { "type": "text", "id": "hero_boton", "label": "Botón", "default": "Descubre las ofertas" },
    { "type": "url", "id": "hero_enlace", "label": "Enlace del botón", "info": "Vacío = todo el catálogo." },
    { "type": "header", "content": "Universo de Marcas" },
    { "type": "text", "id": "uni_kicker", "label": "Antetítulo", "default": "Nuestro" },
    { "type": "text", "id": "uni_titulo", "label": "Título", "default": "Universo de Marcas" },
    { "type": "text", "id": "uni_sub", "label": "Subtítulo", "default": "Las marcas que hacen parte de tu cotidiano" },
    { "type": "header", "content": "Producto protagonista" },
    { "type": "product", "id": "producto", "label": "Producto", "info": "Vacío = Salomon XT-6." },
    { "type": "text", "id": "pp_color", "label": "Color que sale elegido", "default": "Blanco Vainilla" },
    { "type": "image_picker", "id": "pp_imagen", "label": "Imagen editorial", "info": "Vacía = diseño Salomon XT-6 crema." },
    { "type": "text", "id": "pp_kicker", "label": "Antetítulo", "default": "Producto protagonista" },
    { "type": "header", "content": "Más buscados" },
    { "type": "text", "id": "mas_titulo", "label": "Título", "default": "Más buscados" },
    { "type": "collection", "id": "mas_coleccion", "label": "Colección", "info": "Vacía = todo el catálogo." },
    { "type": "textarea", "id": "mas_lista", "label": "Pares elegidos (uno por línea)", "info": "Formato: handle-del-producto | Color (el color es opcional). Si está vacío se usa la colección." },
    { "type": "header", "content": "Cierre de marca" },
    { "type": "image_picker", "id": "com_imagen", "label": "Imagen", "info": "Vacía = fachada de la tienda COTIDIANO." },
    { "type": "text", "id": "com_titulo", "label": "Título", "default": "Haz parte de la comunidad" },
    { "type": "text", "id": "com_texto", "label": "Texto", "default": "Novedades, lanzamientos exclusivos, beneficios y mucho más." },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp", "default": "573103081052" }
  ],
  "blocks": [
    {
      "type": "marca", "name": "Marca", "limit": 12,
      "settings": [
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "Adidas" },
        { "type": "text", "id": "handle", "label": "Página o colección", "default": "adidas", "info": "Si existe la página /pages/este-nombre se usa; si no, la colección." },
        { "type": "image_picker", "id": "imagen", "label": "Imagen (opcional)" },
        { "type": "text", "id": "imagen_tema", "label": "Imagen del tema (avanzado)", "default": "rt-marca-adidas.webp" },
        { "type": "url", "id": "enlace", "label": "Enlace (opcional)" }
      ]
    },
    {
      "type": "destacado", "name": "Par destacado", "limit": 4,
      "settings": [
        { "type": "product", "id": "producto", "label": "Producto" },
        { "type": "text", "id": "marca", "label": "Marca (si no hay logo)" },
        { "type": "text", "id": "logo_tema", "label": "Logo del tema (avanzado)", "info": "Archivo de assets, p. ej. logo-adidas.png" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Destacado" },
        { "type": "text", "id": "kicker", "label": "Texto pequeño", "default": "Colección especial" },
        { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#7A1717" },
        { "type": "color", "id": "raya", "label": "Color de las rayas", "default": "#F2E6CF" },
        { "type": "image_picker", "id": "imagen", "label": "Foto del par (fondo transparente)" },
        { "type": "text", "id": "imagen_tema", "label": "Foto del tema (avanzado)" }
      ]
    },
    {
      "type": "coleccion", "name": "Colección (Hombre/Mujer)", "limit": 4,
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Hombre" },
        { "type": "collection", "id": "coleccion", "label": "Colección" },
        { "type": "image_picker", "id": "imagen", "label": "Imagen editorial", "info": "Sin imagen se usa un fondo retro." }
      ]
    },
    {
      "type": "beneficio", "name": "Beneficio", "limit": 6,
      "settings": [
        { "type": "select", "id": "icono", "label": "Ícono", "default": "envio", "options": [
          { "value": "envio", "label": "Envío" }, { "value": "segura", "label": "Compra segura" }, { "value": "pago", "label": "Pago" },
          { "value": "cambio", "label": "Cambios" }, { "value": "atencion", "label": "Atención" }
        ] },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Envíos a todo Colombia" },
        { "type": "text", "id": "texto", "label": "Texto" }
      ]
    }
  ],
  "presets": [{ "name": "COTIDIANO · Inicio retro" }]
}
{% endschema %}
