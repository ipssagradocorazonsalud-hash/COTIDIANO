  {%- render 'cotidiano-marcas', section: section -%}

  <section class="ct-sec" id="ct-coleccion"><div class="ct-wrap">
    {%- liquid
      # Etiquetas existentes en la tienda como ",a,b,c," para mostrar solo los filtros que tienen productos
      assign gtags = ','
      for t in collections.all.all_tags
        assign tl = t | downcase
        assign gtags = gtags | append: tl | append: ','
      endfor
      # En la tienda publicada all_tags puede llegar vacío: se imprimen todas las opciones y el JS quita las que no tienen productos
      if gtags == ','
        assign gtags = ',hombre,mujer,running,trail,urbanas,color-blanco,color-negro,color-gris,color-azul,color-rosa,color-tierra,color-colores,'
      endif
      assign frases = section.settings.frases_grilla | strip | newline_to_br | split: '<br />'
      assign nfrases = frases.size
      # Heros entre zapatillas (bloques de la sección) y contadores de frases/heros ya usados
      assign heros = section.blocks | where: 'type', 'hero'
      assign nheros = heros.size
      assign hi = 0
      assign fi = 0
      # "Más vendidos" solo si existe la colección mas-vendidos ordenada por ventas en Shopify
      assign mvc = collections['mas-vendidos']
      assign hay_mv = false
      if mvc != blank and mvc.default_sort_by == 'best-selling' and mvc.products_count > 0
        assign hay_mv = true
      endif
      assign colores = 'blanco:Blanco,negro:Negro,gris:Gris,azul:Azul,rosa:Rosa / lila,tierra:Tierra / café,colores:Colores' | split: ','
      assign svg_qv = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>'
      capture trust
        echo '<div class="ct-trust"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6.5" width="19" height="11" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 10v4M18 10v4"/></svg>Contra entrega <span aria-hidden="true">·</span> <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 9.5h4l3 3.2v3.8h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Envío nacional</div>'
      endcapture
    -%}
    <div class="ct-col-head">
      <h2 class="ct-h2">{{ section.settings.col_titulo }} <em>{{ section.settings.col_acento }}</em></h2>
      <p class="ct-count" id="ctCount" aria-live="polite"></p>
    </div>
    <div class="ct-fbar" id="ctFBar" role="search" aria-label="Filtros de la colección">
      <label class="ct-search"><span class="ct-sr">Buscar zapatillas</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><input type="search" id="ctQ" placeholder="Buscar zapatillas" autocomplete="off"></label>
      {%- if gtags contains ',hombre,' or gtags contains ',mujer,' -%}
        <div class="ct-seg" role="group" aria-label="Para quién">
          <button type="button" data-k="genero" data-val="" aria-pressed="true">Todos</button>
          {%- if gtags contains ',hombre,' -%}<button type="button" data-k="genero" data-val="hombre" aria-pressed="false">Hombre</button>{%- endif -%}
          {%- if gtags contains ',mujer,' -%}<button type="button" data-k="genero" data-val="mujer" aria-pressed="false">Mujer</button>{%- endif -%}
        </div>
      {%- endif -%}
      <button type="button" class="ct-fbtn" id="ctFBtn" aria-expanded="false" aria-controls="ctFPanel" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>Filtros<span class="ct-fnum" id="ctFNum"></span></button>
      <label class="ct-sort"><span class="ct-sr">Ordenar por</span>
        <select id="ctSort">
          <option value="dest">Destacados</option>
          {%- if hay_mv -%}<option value="mv">Más vendidos</option>{%- endif -%}
          <option value="nuevos">Nuevos</option>
          <option value="asc">Menor precio</option>
          <option value="desc">Mayor precio</option>
        </select>
      </label>
    </div>
    <div class="ct-act" id="ctAct" aria-label="Filtros aplicados" hidden><span id="ctActChips" style="display:contents"></span><button type="button" class="ct-clear" id="ctClear">Limpiar</button></div>

    <div class="ct-fpanel" id="ctFPanel" role="dialog" aria-modal="true" aria-labelledby="ctFTitle">
      <div class="ct-fpanel-top" id="ctFTop"><span class="ct-fgrab" aria-hidden="true"></span><b id="ctFTitle">Filtros</b><button type="button" class="ct-x" data-fclose aria-label="Cerrar filtros">✕</button></div>
      <div class="ct-fbody">
        {%- comment -%} Marca = campo "Proveedor" del producto en Shopify; sin selección se muestran todas {%- endcomment -%}
        {%- assign marcas_f = collections.all.all_vendors | sort_natural -%}
        {%- if marcas_f.size > 1 -%}
          <div class="ct-fg" role="group" aria-labelledby="ctFhMarca"><span class="ct-fh" id="ctFhMarca">Marca</span><div class="ct-fopts">
            {%- for mv in marcas_f -%}<button type="button" class="ct-chip" data-k="marca" data-val="{{ mv | handleize }}" aria-pressed="false">{{ mv }}</button>{%- endfor -%}
          </div></div>
        {%- endif -%}
        {%- if gtags contains ',running,' or gtags contains ',trail,' or gtags contains ',urbanas,' -%}
          <div class="ct-fg" role="group" aria-labelledby="ctFhEstilo"><span class="ct-fh" id="ctFhEstilo">Estilo</span><div class="ct-fopts">
            {%- if gtags contains ',running,' -%}<button type="button" class="ct-chip" data-k="estilo" data-val="running" aria-pressed="false">Running</button>{%- endif -%}
            {%- if gtags contains ',trail,' -%}<button type="button" class="ct-chip" data-k="estilo" data-val="trail" aria-pressed="false">Trail</button>{%- endif -%}
            {%- if gtags contains ',urbanas,' -%}<button type="button" class="ct-chip" data-k="estilo" data-val="urbanas" aria-pressed="false">Urbanas</button>{%- endif -%}
          </div></div>
        {%- endif -%}
        <div class="ct-fg" role="group" aria-labelledby="ctFhTalla"><span class="ct-fh" id="ctFhTalla">Talla (EU)</span><div class="ct-fopts ct-tallas">
          {%- for t in (35..44) -%}<button type="button" class="ct-tf" data-k="talla" data-val="{{ t }}" aria-pressed="false" aria-label="Talla {{ t }}">{{ t }}</button>{%- endfor -%}
        </div></div>
        {%- capture circulos -%}
          {%- for c in colores -%}
            {%- assign cp = c | split: ':' -%}
            {%- assign ck = ',color-' | append: cp[0] | append: ',' -%}
            {%- if gtags contains ck -%}<button type="button" class="ct-sw ct-sw-{{ cp[0] }}" data-k="color" data-val="{{ cp[0] }}" aria-pressed="false" aria-label="Color {{ cp[1] }}" title="{{ cp[1] }}"></button>{%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if circulos != blank -%}
          <div class="ct-fg" role="group" aria-labelledby="ctFhColor"><span class="ct-fh" id="ctFhColor">Color</span><div class="ct-fopts">{{ circulos }}</div></div>
        {%- endif -%}
      </div>
      <button type="button" class="ct-fdone" data-fclose>Ver <span id="ctCount2"></span></button>
    </div>
    <div class="ct-fshade" id="ctFShade" hidden></div>

    {%- assign ctjson = '' -%}
    {%- paginate collections.all.products by 120 -%}
    <div class="ct-grid" id="ctGrid" data-wa="{{ wa }}" data-promo="{{ section.settings.promo_segundo_par | strip | escape }}">
      {%- for product in collections.all.products -%}
        {%- liquid
          assign ptc = product.tags | join: ',' | downcase
          assign ptc = ',' | append: ptc | append: ','
          assign estilo = ''
          if ptc contains ',cloud,'
            assign estilo = 'Cloud'
          elsif ptc contains ',trail,'
            assign estilo = 'Trail'
          elsif ptc contains ',running,'
            assign estilo = 'Running'
          endif
          assign topt = 1
          for o in product.options_with_values
            assign onm = o.name | downcase
            if onm contains 'talla' or onm contains 'size'
              assign topt = forloop.index
            endif
          endfor
          assign tdisp = ','
          for v in product.variants
            case topt
              when 2
                assign vt = v.option2
              when 3
                assign vt = v.option3
              else
                assign vt = v.option1
            endcase
            if v.available
              assign tdisp = tdisp | append: vt | append: ','
            endif
          endfor
          assign alt_img = product.images[1]
        -%}
        <article class="ct-card ct-it{% if alt_img %} has-alt{% endif %}" data-buy data-h="{{ product.handle }}" data-marca="{{ product.vendor | handleize }}" data-tags="{{ ptc | escape }}" data-tallas="{{ tdisp | escape }}" data-precio="{{ product.price }}" data-pub="{{ product.published_at | date: '%s' }}" data-nombre="{{ product.title | escape }}">
          <div class="ct-img">
            <a class="ct-img-a" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: '', class: 'main' }}{%- endif -%}
              {%- if alt_img -%}{{ alt_img | image_url: width: 700 | image_tag: loading: 'lazy', alt: '', class: 'alt' }}{%- endif -%}
            </a>
            {%- if ptc contains ',nuevo,' -%}<span class="ct-new">NUEVO</span>{%- endif -%}
            <label class="ct-cmp"><input type="checkbox" class="ct-cmp-in" aria-label="Comparar {{ product.title | escape }}">Comparar</label>
          </div>
          {%- comment -%} Tarjeta limpia: solo nombre y color. Al tocarla se abre la vista rápida con precio, tallas y guía de conversión {%- endcomment -%}
          <h3><a class="ct-open" href="{{ product.url }}" aria-haspopup="dialog">{{ product.title }}</a></h3>
          {%- capture ccol -%}
            {%- for c in colores -%}
              {%- assign cp = c | split: ':' -%}
              {%- assign ck = ',color-' | append: cp[0] | append: ',' -%}
              {%- if ptc contains ck -%}<span><i class="ct-dot ct-sw-{{ cp[0] }}" aria-hidden="true"></i>{{ cp[1] }}</span>{%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if ccol != blank -%}<div class="ct-color"><span class="ct-sr">Color:</span>{{ ccol }}</div>{%- endif -%}
          <div class="ct-hint" aria-live="polite"></div>
        </article>
        {%- capture pj -%}
          {"h":{{ product.handle | json }},"t":{{ product.title | json }},"u":{{ product.url | json }},"vd":{{ product.vendor | json }},"p":{{ product.price | money_without_trailing_zeros | json }},"e":{{ estilo | json }},"i":[{%- for im in product.images limit: 6 -%}{{ im | image_url: width: 900 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"s":[{%- for v in product.variants -%}{%- case topt -%}{%- when 2 -%}{%- assign vt = v.option2 -%}{%- when 3 -%}{%- assign vt = v.option3 -%}{%- else -%}{%- assign vt = v.option1 -%}{%- endcase -%}[{{ vt | json }},{{ v.id }},{{ v.available }},{% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %}]{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
        {%- endcapture -%}
        {%- assign ctjson = ctjson | append: pj | append: ',' -%}
        {%- comment -%}
          Cada 6 productos va un espacio especial. Se alternan: frase, hero, frase, hero…
          Si las frases están apagadas, todos los espacios son heros (6 zapatillas, hero, 6 zapatillas, hero…).
          Cuando se acaban los heros (bloques "Hero entre zapatillas"), los espacios siguientes son frases.
          Las frases rotan los estilos 1·2·3 (la 3.ª lleva la guía de tallas).
        {%- endcomment -%}
        {%- assign m6 = forloop.index | modulo: 6 -%}
        {%- if m6 == 0 and forloop.last == false -%}
          {%- assign k = forloop.index | divided_by: 6 | minus: 1 -%}
          {%- assign k2 = k | modulo: 2 -%}
          {%- liquid
            assign usar_hero = false
            if nheros > hi
              if k2 == 1 or section.settings.frases_activas == false
                assign usar_hero = true
              endif
            endif
          -%}
          {%- if usar_hero -%}
            {%- assign hb = heros[hi] -%}
            {%- assign hi = hi | plus: 1 -%}
            {%- render 'cotidiano-hero-grilla', block: hb, wa: wa -%}
          {%- elsif nfrases > 0 and section.settings.frases_activas -%}
            {%- assign ki = fi | modulo: nfrases -%}
            {%- assign est = fi | modulo: 3 | plus: 1 -%}
            {%- assign fi = fi | plus: 1 -%}
            {%- assign frase = frases[ki] | strip -%}
            <div class="ct-frase ct-slot ct-fr{{ est }}">
              <span class="ct-fr-m" aria-hidden="true">“</span>
              <p class="ct-fr-q">{{ frase | escape }}</p>
              {%- if est == 3 -%}
                <div class="ct-fr-guia"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 15.5 15.5 3l5.5 5.5L8.5 21z"/><path d="M7 12l2 2M10 9l1.5 1.5M13 6l2 2M8.5 15.5 10 17"/></svg><span>¿Entre dos tallas? Mide tu pie y te decimos cuál.</span><button type="button" class="ct-fr-btn" data-guia>Encuentra tu talla</button></div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        <p>Pronto verás aquí nuestros productos.</p>
      {%- endfor -%}
    </div>
    {%- endpaginate -%}
    <template id="ctTrustTpl">{{ trust }}</template>
    <script type="application/json" id="ctData">[{{ ctjson | remove_last: ',' }}]</script>
    <script type="application/json" id="ctMV">[{%- if hay_mv -%}{%- for p in mvc.products -%}{{ p.handle | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endif -%}]</script>
    <div class="ct-empty" id="ctEmpty" hidden>
