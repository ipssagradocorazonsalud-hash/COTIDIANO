  /* "Lleva otro par": sugiere 1 zapatilla del mismo estilo, priorizando la misma talla disponible */
  function sugerir(h,talla){
    var p=DATA[h];upEl.hidden=true;upEl.innerHTML='';
    if(!p||!p.e)return false;
    var cand=Object.keys(DATA).map(function(k){return DATA[k];}).filter(function(o){return o.h!==h&&o.e===p.e&&o.s.some(function(s){return s[2];});});
    if(!cand.length)return false;
    var misma=cand.filter(function(o){return o.s.some(function(s){return s[2]&&String(s[0])===String(talla);});});
    var pool=misma.length?misma:cand,o=pool[Math.floor(Math.random()*pool.length)];
    var v=null;o.s.forEach(function(s){if(s[2]&&String(s[0])===String(talla))v=s[1];});
    var promo=grid?grid.dataset.promo:'';
    upEl.innerHTML=(o.i[0]?'<img src="'+esc(o.i[0])+'" alt="" loading="lazy">':'')+
      '<span><span class="ct-up-l">'+(promo?esc(promo):'Te puede gustar')+'</span><span class="ct-up-n">'+esc(o.t)+' · '+esc(o.p)+'</span></span>'+
