          <div class="ct-rueda" id="ctRueda">
            {%- comment -%} Primero las zapatillas destacadas (opcionales), luego la colección, sin repetir y solo con imagen {%- endcomment -%}
            {%- for hp in (1..3) -%}
              {%- case hp -%}
                {%- when 1 -%}{%- assign p = section.settings.hero_p1 -%}
                {%- when 2 -%}{%- assign p = section.settings.hero_p2 -%}
                {%- else -%}{%- assign p = section.settings.hero_p3 -%}
              {%- endcase -%}
              {%- if rn < rmax and p != blank and p.featured_image -%}
                {%- assign rclave = ',' | append: p.handle | append: ',' -%}
                {%- unless rvistos contains rclave -%}
                  {%- assign rvistos = rvistos | append: p.handle | append: ',' -%}
                  <a class="ct-rc{% if rn == 0 %} front{% endif %}" href="{{ p.url }}" draggable="false">
                    {{ p.featured_image | image_url: width: 700 | image_tag: alt: p.title, loading: 'eager', draggable: 'false', sizes: '(max-width: 900px) 200px, 270px' }}
                    <span class="lbl"><span>{{ p.title }}</span><b>{{ p.price | money_without_trailing_zeros }}</b></span>
                  </a>
                  {%- assign rn = rn | plus: 1 -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for p in rcol.products -%}
              {%- if rn >= rmax -%}{%- break -%}{%- endif -%}
              {%- if p.featured_image -%}
                {%- assign rclave = ',' | append: p.handle | append: ',' -%}
                {%- unless rvistos contains rclave -%}
                  {%- assign rvistos = rvistos | append: p.handle | append: ',' -%}
                  <a class="ct-rc{% if rn == 0 %} front{% endif %}" href="{{ p.url }}" draggable="false">
                    {{ p.featured_image | image_url: width: 700 | image_tag: alt: p.title, loading: 'eager', draggable: 'false', sizes: '(max-width: 900px) 200px, 270px' }}
                    <span class="lbl"><span>{{ p.title }}</span><b>{{ p.price | money_without_trailing_zeros }}</b></span>
                  </a>
                  {%- assign rn = rn | plus: 1 -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="ct-ring-hold" aria-hidden="true"><span class="ct-ring"></span></span>
        </div>
        {%- if rn > 1 -%}
          <div class="ct-rctl">
            <button type="button" class="ct-rbtn" id="ctRPrev" aria-label="Zapatilla anterior">←</button>
            <span>Arrastra para girar</span>
            <button type="button" class="ct-rbtn" id="ctRNext" aria-label="Zapatilla siguiente">→</button>
