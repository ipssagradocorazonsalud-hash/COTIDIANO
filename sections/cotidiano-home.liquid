    pintarBarra();
  });
  function quitarComparar(){cmp=[];if(grid)grid.querySelectorAll('.ct-cmp-in').forEach(function(c){c.checked=false;});pintarBarra();}
  document.getElementById('ctCBarX').addEventListener('click',quitarComparar);
  document.getElementById('ctCBarGo').addEventListener('click',function(){
    var ps=cmp.map(function(h){return DATA[h];}).filter(Boolean);
    function fila(nombre,fn){return '<tr><th scope="row">'+nombre+'</th>'+ps.map(function(p){return '<td>'+fn(p)+'</td>';}).join('')+'</tr>';}
    compBody.innerHTML='<table class="ct-ctab">'+
      fila('<span class="ct-sr">Imagen</span>',function(p){return p.i[0]?'<img src="'+esc(p.i[0])+'" alt="" loading="lazy">':'';})+
      fila('Nombre',function(p){return '<a class="nm" href="'+esc(p.u)+'" style="color:inherit;text-decoration:none">'+esc(p.t)+'</a>';})+
      fila('Estilo',function(p){return p.e?esc(p.e):'—';})+
      fila('Precio',function(p){return '<span class="ct-price">'+esc(p.p)+'</span>';})+
      fila('Tallas disponibles',function(p){return '<div data-buy data-h="'+esc(p.h)+'" style="display:flex;flex-direction:column">'+tallasHTML(p)+'<button type="button" class="ct-add">Agregar</button></div>';})+
      '</table>';
    if(F.talla)compBody.querySelectorAll('[data-buy]').forEach(function(s){elegirTalla(s,F.talla);});
    comp.classList.add('show');abrirDialogo(comp,comp.querySelector('.ct-modal'),this,cerrarComp);
  });
  function cerrarComp(){if(!comp.classList.contains('show'))return;comp.classList.remove('show');cerrarDialogo(comp);}
  comp.addEventListener('click',function(e){if(e.target===comp||e.target.closest('[data-compclose]'))cerrarComp();});
  var ov=document.getElementById('ctGuia'),len=document.getElementById('ctLen');
  function tabla(){var v=parseFloat(String(len.value).replace(',','.')),hit=-1;if(!isNaN(v))for(var i=0;i < CONV.length;i++){if(v<=CONV[i][4]){hit=i;break;}}
    document.getElementById('ctTabla').innerHTML=convHTML(hit < 0?null:CONV[hit][0]);
    var c=hit < 0?null:CONV[hit];
    document.getElementById('ctRes').textContent=isNaN(v)?'':(hit < 0?'Escríbenos por WhatsApp':'Tu talla: EU '+c[0]+' (USA hombre '+c[1]+' · USA mujer '+c[2]+' · UK '+c[3]+')');}
  function abrirGuia(){ov.classList.add('show');tabla();}
  document.getElementById('ctGuiaX').onclick=function(){ov.classList.remove('show');};
  ov.addEventListener('click',function(e){if(e.target===ov)ov.classList.remove('show');});
  len.addEventListener('input',tabla);
})();
</script>

