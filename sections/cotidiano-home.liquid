{%- comment -%} Cotidiano Shoes · Página de inicio (sección personalizada) {%- endcomment -%}
{%- liquid
  # Número de WhatsApp del inicio; si el campo está vacío o con el número de ejemplo, se usa el de la tienda
  assign wa = section.settings.whatsapp | remove: '+' | remove: ' '
  if wa == blank or wa == '573000000000'
    assign wa = '573103081052'
  endif
-%}
{{ 'cotidiano-heros.css' | asset_url | stylesheet_tag }}
<style>
  .ct{--azul:#0B63CE;--azul2:#0952AD;--marino:#0F2A47;--cielo:#7CC4FF;--suave:#5A6F88;--linea:rgba(15,42,71,.12);--fondo2:#F2F7FD;font-family:inherit;color:var(--marino)}
  .ct *{box-sizing:border-box}
  .ct-wrap{max-width:1200px;margin:0 auto;padding:0 20px}
  .ct-hero{position:relative;min-height:min(86vh,760px);display:flex;align-items:center;overflow:hidden;color:#fff;background:radial-gradient(1200px 700px at 85% 20%,#1d74e0 0%,transparent 60%),linear-gradient(135deg,#0F2A47 0%,#0B3A7A 55%,#0B63CE 100%);--mx:.5;--my:.5;isolation:isolate}
  .ct-hero::before{content:'';position:absolute;inset:0;z-index:-1;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(circle at calc(var(--mx)*100%) calc(var(--my)*100%),#000 0%,transparent 55%);-webkit-mask-image:radial-gradient(circle at calc(var(--mx)*100%) calc(var(--my)*100%),#000 0%,transparent 55%)}
  .ct-spot{position:absolute;width:620px;height:620px;border-radius:50%;left:calc(var(--mx)*100% - 310px);top:calc(var(--my)*100% - 310px);background:radial-gradient(circle,rgba(124,196,255,.38),rgba(124,196,255,0) 65%);pointer-events:none;z-index:0;transition:left .25s ease-out,top .25s ease-out}
  .ct-word{position:absolute;right:-2%;bottom:-6%;font-size:clamp(6rem,19vw,17rem);font-weight:900;letter-spacing:-.04em;color:transparent;-webkit-text-stroke:2px rgba(255,255,255,.12);white-space:nowrap;pointer-events:none;transform:translate(calc((var(--mx) - .5)*-40px),calc((var(--my) - .5)*-20px));z-index:0;text-transform:uppercase}
  .ct-hero-grid{position:relative;z-index:2;width:100%;display:grid;grid-template-columns:1fr 1.05fr;gap:20px;align-items:center;padding:56px 20px}
  .ct-logo-hero{display:block;height:auto;width:min(340px,70%);margin:0 0 18px;filter:drop-shadow(0 8px 20px rgba(0,0,0,.25))}
  .ct-tag{display:inline-block;font-size:.75rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--cielo);border:1px solid rgba(124,196,255,.5);padding:7px 14px;border-radius:999px;margin-bottom:18px;background:rgba(124,196,255,.08)}
  .ct-hero h1{font-size:clamp(2.6rem,6.2vw,5.6rem);line-height:.95;margin:0 0 18px;text-transform:uppercase;font-weight:900;letter-spacing:-.015em;color:#fff}
  .ct-hero h1 em{font-style:normal;color:var(--cielo)}
  .ct-hero p{color:#d3e2f5;font-size:1.08rem;max-width:460px;margin:0 0 22px}
  .ct-pills{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:22px}
  .ct-pills span{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#b7c9e0;font-weight:700}
  .ct-pill{padding:10px 20px;border-radius:999px;border:1.5px solid rgba(255,255,255,.45);color:#fff;font-weight:700;cursor:pointer;background:none;font-size:.95rem;transition:all .2s}
  .ct-pill:hover{background:#fff;color:var(--marino)}
  .ct-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:700;padding:15px 28px;border-radius:999px;text-decoration:none;border:none;cursor:pointer;font-size:1rem;transition:transform .2s,background .2s}
  .ct-btn:hover{transform:translateY(-2px)}
  .ct-btn-azul{background:#fff;color:var(--azul);box-shadow:0 14px 34px rgba(0,0,0,.25)}
  .ct-btn-borde{border:1.5px solid rgba(255,255,255,.45);color:#fff;background:none}
  .ct-btn-blanco{background:#fff;color:var(--azul)}
  .ct-marcas{margin-top:24px;font-weight:700;font-size:.78rem;letter-spacing:.16em;color:#c3d4ea}
  .ct-marcas b{color:var(--cielo);margin-right:8px}
  /* Ruleta de diseños del hero: el JS posiciona cada tarjeta en un círculo (ver "Ruleta" en el script) */
  .ct-stage{position:relative;height:min(62vh,560px);display:flex;flex-direction:column}
  .ct-ruleta{position:relative;flex:1;min-height:0;perspective:1100px;touch-action:pan-y;cursor:grab;user-select:none;-webkit-user-select:none}
  .ct-ruleta.drag{cursor:grabbing}
  .ct-rueda{position:absolute;inset:0;transform-style:preserve-3d;will-change:transform}
  .ct-orbita{position:absolute;left:50%;top:58%;width:84%;height:30%;translate:-50% -50%;border:2px dashed rgba(124,196,255,.45);border-radius:50%;pointer-events:none}
  .ct-rc{position:absolute;left:50%;top:50%;width:min(270px,46%);aspect-ratio:1/1;border-radius:28px;background:linear-gradient(150deg,#2a7fe6 0%,#0d4a9c 100%);border:1px solid rgba(255,255,255,.28);box-shadow:0 34px 64px rgba(4,16,36,.5),0 10px 22px rgba(4,16,36,.3);text-decoration:none;color:#fff;transform:translate(-50%,-50%);-webkit-user-drag:none;will-change:transform,opacity,filter;transition:border-color .3s,box-shadow .3s}
  .ct-rc img{display:block;width:100%;height:100%;object-fit:contain;padding:9% 9% 17%;filter:drop-shadow(0 22px 24px rgba(4,16,36,.45));pointer-events:none;-webkit-user-drag:none;transition:transform .5s cubic-bezier(.3,1.4,.5,1)}
  .ct-rc .lbl{position:absolute;left:16px;right:16px;bottom:14px;display:flex;justify-content:space-between;gap:10px;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;opacity:0;translate:0 6px;transition:opacity .3s,translate .3s}
  .ct-rc .lbl span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ct-rc .lbl b{color:var(--cielo);flex-shrink:0}
  .ct-rc.front{border-color:#7CC4FF;box-shadow:0 44px 90px rgba(4,16,36,.65),0 0 0 1px #7CC4FF,0 0 38px rgba(124,196,255,.35)}
  .ct-rc.front img{transform:rotate(-6deg) scale(1.1)}
  .ct-rc.front .lbl{opacity:1;translate:0 0}
  .ct-ring-hold{position:absolute;left:50%;top:50%;width:min(270px,46%);aspect-ratio:1/1;translate:-50% -50%;pointer-events:none;z-index:200}
  .ct-rctl{display:flex;align-items:center;justify-content:center;gap:16px;padding-top:14px}
  .ct-rbtn{width:46px;height:46px;border-radius:50%;border:1.5px solid rgba(255,255,255,.45);background:rgba(255,255,255,.08);color:#fff;font-size:1.15rem;line-height:1;cursor:pointer;display:grid;place-items:center;transition:background .2s,color .2s,transform .2s}
  .ct-rbtn:hover{background:#fff;color:var(--marino);transform:scale(1.06)}
  .ct-rctl span{font-size:.72rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#b7c9e0}
  .ct-hint-mouse{position:absolute;right:20px;bottom:64px;z-index:3;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#b7c9e0}
  @media(max-width:900px){.ct-hero-grid{grid-template-columns:1fr;padding-top:36px}.ct-stage{height:auto}.ct-ruleta{flex:none;height:400px}.ct-rc,.ct-ring-hold{width:200px}.ct-hint-mouse{display:none}.ct-word{display:none}}
  @media(prefers-reduced-motion:reduce){.ct-rc,.ct-rc img,.ct-rc .lbl,.ct-spot,.ct-word{transition:none}}
  /* Animación de entrada del hero: usa translate/scale (no transform) para no pisar el efecto del mouse */
  .ct-ring{position:absolute;left:50%;top:50%;width:100%;aspect-ratio:1/1;margin:-50% 0 0 -50%;border-radius:50%;border:3px solid #7CC4FF;box-shadow:0 0 24px rgba(124,196,255,.6);opacity:0;pointer-events:none}
  @media(prefers-reduced-motion:no-preference){
    .ct-intro .ct-logo-hero{animation:ctWrite 1.3s cubic-bezier(.65,0,.35,1) both}
    .ct-intro .ct-word{animation:ctWord 1.2s cubic-bezier(.16,1,.3,1) .1s both}
    .ct-intro .ct-stage{animation:ctDrop 1s 1.05s both}
    .ct-intro .ct-ring{animation:ctRing .9s cubic-bezier(.2,.7,.3,1) 1.6s both}
    .ct-intro .ct-tag,.ct-intro h1,.ct-intro .ct-hero-grid>div:first-child>p,.ct-intro .ct-pills,.ct-intro .ct-btn,.ct-intro .ct-marcas{animation:ctUp .6s cubic-bezier(.2,.7,.3,1) .45s both}
    .ct-intro h1{animation-delay:.57s}
    .ct-intro .ct-hero-grid>div:first-child>p{animation-delay:.69s}
    .ct-intro .ct-pills{animation-delay:.81s}
    .ct-intro .ct-btn-azul{animation-delay:.93s}
    .ct-intro .ct-btn-borde{animation-delay:1.05s}
    .ct-intro .ct-marcas{animation-delay:1.17s}
  }
  @keyframes ctWrite{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}
  @keyframes ctWord{from{translate:60vw 0;opacity:0}to{translate:0 0;opacity:1}}
  @keyframes ctDrop{
    0%{translate:0 -110vh;scale:1;opacity:0;animation-timing-function:cubic-bezier(.55,0,1,.45)}
    15%{opacity:1}
    55%{translate:0 0;scale:1.05 .94;animation-timing-function:cubic-bezier(0,.55,.45,1)}
    72%{translate:0 -22px;scale:.98 1.03;animation-timing-function:cubic-bezier(.55,0,1,.45)}
    86%{translate:0 0;scale:1.02 .98;animation-timing-function:cubic-bezier(0,.55,.45,1)}
    94%{translate:0 -5px;scale:1}
    100%{translate:0 0;scale:1;opacity:1}}
  @keyframes ctRing{from{scale:.5;opacity:.9}to{scale:1.7;opacity:0}}
  @keyframes ctUp{from{translate:0 26px;opacity:0}to{translate:0 0;opacity:1}}
  /* Cinta animada bajo el hero */
  .ct-cinta-wrap{position:relative;z-index:3;margin-top:-56px;padding:26px 0;overflow:hidden;pointer-events:none}
  .ct-cinta{width:110%;margin-left:-5%;background:#0F2A47;border-top:2px solid #7CC4FF;border-bottom:2px solid #7CC4FF;transform:rotate(-1.6deg);overflow:hidden;box-shadow:0 14px 34px rgba(4,16,36,.3);pointer-events:auto}
  .ct-cinta-track{display:flex;width:max-content;will-change:transform}
  .ct-cinta-set{display:flex;align-items:center;flex-shrink:0}
  .ct-ci{display:inline-flex;align-items:center;gap:10px;padding:16px 0;color:#fff;text-transform:uppercase;font-weight:900;font-size:1.05rem;letter-spacing:.04em;white-space:nowrap;transition:color .25s}
  .ct-ci small{font-size:.72rem;font-weight:900;letter-spacing:.08em;opacity:.6}
  .ct-ci svg{width:26px;height:26px;flex-shrink:0;fill:none;stroke:#7CC4FF;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .5s cubic-bezier(.3,1.4,.5,1)}
  .ct-ci:hover{color:#7CC4FF}.ct-ci:hover small{opacity:1}
  .ct-ci:hover svg{transform:rotate(360deg)}
  .ct-cs{color:#7CC4FF;padding:0 26px;font-size:1rem}
  @media(max-width:900px){.ct-cinta-wrap{margin-top:-48px;padding:18px 0}.ct-ci{font-size:.8rem;gap:7px;padding:12px 0}.ct-ci small{font-size:.6rem}.ct-ci svg{width:20px;height:20px}.ct-cs{padding:0 16px;font-size:.8rem}}
  /* Notificación "Dicho cotidiano" */
  .ct-dicho{position:fixed;left:20px;bottom:24px;z-index:9400;width:min(340px,calc(100vw - 40px));background:#fff;border-radius:18px;box-shadow:0 18px 44px rgba(15,42,71,.22);padding:14px 40px 14px 14px;display:flex;gap:12px;align-items:center;color:#0F2A47;opacity:0;translate:0 24px;pointer-events:none;transition:opacity .4s,translate .4s cubic-bezier(.2,.7,.3,1)}
  .ct-dicho.show{opacity:1;translate:0 0;pointer-events:auto}
  /* .av: botón de play/pausa; el anillo celeste late para invitar a tocarlo y se detiene mientras suena */
  .ct-dicho-ic{position:relative;width:44px;height:44px;flex-shrink:0;border:none;padding:0;border-radius:12px;background:linear-gradient(135deg,#0F2A47,#0B63CE);display:flex;align-items:center;justify-content:center;cursor:pointer}
  .ct-dicho-ic::after{content:'';position:absolute;inset:-4px;border-radius:15px;border:2px solid #7CC4FF;pointer-events:none;animation:ctLate 1.6s ease-out infinite}
  .ct-dicho-ic.playing::after{animation:none;opacity:0}
  .ct-dicho-ic svg{width:20px;height:20px;fill:#fff}
  .ct-dicho-ic .i-pausa,.ct-dicho-ic.playing .i-play{display:none}
  .ct-dicho-ic.playing .i-pausa{display:block}
  .ct-dicho-ic:focus-visible{outline:2px solid #0B63CE;outline-offset:5px}
  @keyframes ctLate{0%{scale:1;opacity:.95}100%{scale:1.35;opacity:0}}
  .ct-dicho-txt{display:block;font-weight:700;font-size:.95rem;line-height:1.3}
  .ct-dicho-hint{display:block;margin-top:3px;color:#5A6F88;font-size:.72rem;font-weight:600}
  .ct-dicho-x{position:absolute;top:8px;right:8px;width:28px;height:28px;border:none;border-radius:50%;background:#eef3fa;color:#0F2A47;cursor:pointer;font-size:.8rem;line-height:1}
  @media(max-width:900px){.ct-dicho{left:12px;bottom:96px;width:calc(100vw - 24px)}}
  @media(prefers-reduced-motion:reduce){.ct-dicho{transition:opacity .2s;translate:none}.ct-dicho-ic::after{animation:none;opacity:.7}}
  .ct-sec{padding:70px 0}
  .ct-h2{font-size:clamp(2rem,4.5vw,3.4rem);text-transform:uppercase;font-weight:900;margin:0 0 26px;line-height:1}
  .ct-h2 em{font-style:normal;color:var(--azul)}
  /* ── Colección: barra de filtros, grilla con frases, vista rápida, comparar y "lleva otro par" ── */
  .ct-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .ct-col-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px 20px;flex-wrap:wrap;margin-bottom:18px}
  .ct-col-head .ct-h2{margin:0}
  .ct-count{margin:0;color:var(--suave);font-weight:700;font-size:.95rem}
  /* Barra visible: buscador · Todos/Hombre/Mujer · Filtros · Ordenar */
  .ct-fbar{position:sticky;top:var(--ct-top,0px);z-index:50;display:flex;align-items:center;gap:10px;background:#fff;border-radius:20px;padding:10px;margin-bottom:12px;box-shadow:0 6px 22px rgba(15,42,71,.08);outline:8px solid var(--fondo2);transition:box-shadow .25s}
  .ct-fbar.stuck{box-shadow:0 14px 34px rgba(15,42,71,.16)}
  .ct-fl{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:800;color:var(--suave);margin-right:2px}
  .ct-seg{display:flex;flex-shrink:0;padding:4px;border-radius:999px;background:var(--fondo2)}
  .ct-seg button{padding:8px 16px;border:none;border-radius:999px;background:none;color:var(--suave);font-family:inherit;font-weight:700;font-size:.86rem;cursor:pointer;transition:background .2s,color .2s}
  .ct-seg button:hover{color:var(--azul)}
  .ct-seg button[aria-pressed="true"]{background:var(--azul);color:#fff}
  .ct-fbtn{display:inline-flex;align-items:center;gap:8px;flex-shrink:0;padding:10px 16px;border-radius:999px;border:1px solid var(--linea);background:#fff;color:var(--marino);font-family:inherit;font-weight:700;font-size:.88rem;cursor:pointer;transition:border-color .2s}
  .ct-fbtn:hover,.ct-fbtn[aria-expanded="true"]{border-color:var(--azul)}
  .ct-fnum{display:inline-grid;place-items:center;min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:var(--azul);color:#fff;font-size:.72rem;font-weight:800;line-height:1}
  .ct-fnum:empty{display:none}
  .ct-sort{position:relative;flex-shrink:0;margin:0}
  .ct-sort select{appearance:none;-webkit-appearance:none;padding:10px 34px 10px 14px;border-radius:999px;border:1px solid var(--linea);background:#fff;font-family:inherit;font-weight:700;font-size:.88rem;color:var(--marino);cursor:pointer;max-width:100%;text-overflow:ellipsis}
  .ct-sort::after{content:'';position:absolute;right:15px;top:50%;width:7px;height:7px;border-right:2px solid var(--marino);border-bottom:2px solid var(--marino);translate:0 -70%;rotate:45deg;pointer-events:none}
  /* Chips de filtros activos bajo la barra */
  .ct-act{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:0 0 22px}
  .ct-act[hidden]{display:none}
  .ct-act-chip{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border:none;border-radius:999px;background:var(--marino);color:#fff;font-family:inherit;font-weight:700;font-size:.8rem;cursor:pointer}
  .ct-act-chip span{opacity:.7;font-size:.75rem}
  .ct-act-chip:hover{background:var(--azul)}
  .ct-clear{border:none;background:none;padding:4px;color:var(--azul);font-family:inherit;font-weight:700;font-size:.85rem;text-decoration:underline;cursor:pointer}
  /* Panel de filtros: lateral derecho en escritorio, hoja inferior en celular */
  .ct-fpanel{position:fixed;top:0;right:0;bottom:0;z-index:9350;width:min(380px,100vw);display:flex;flex-direction:column;background:#fff;color:var(--marino);box-shadow:-20px 0 50px rgba(15,42,71,.25);translate:105% 0;visibility:hidden;transition:translate .3s cubic-bezier(.2,.7,.3,1),visibility 0s .3s}
  .ct-fpanel.open{translate:0 0;visibility:visible;transition:translate .3s cubic-bezier(.2,.7,.3,1)}
  .ct-fpanel.drag{transition:none}
  .ct-fpanel-top{position:relative;display:flex;justify-content:space-between;align-items:center;padding:20px 20px 12px;font-size:1.25rem;font-weight:800}
  .ct-fgrab{display:none}
  .ct-fpanel-top .ct-x{width:38px;height:38px;border-radius:50%;border:1px solid var(--linea);background:#fff;color:var(--marino);font-size:1rem;cursor:pointer}
  .ct-fbody{flex:1;overflow:auto;overscroll-behavior:contain;padding:4px 20px 20px}
  .ct-fg{margin:0;padding:16px 0;border-top:1px solid var(--linea)}
  .ct-fg:first-child{border-top:none}
  .ct-fh{display:block;margin:0 0 12px;font-size:1rem;font-weight:800;color:var(--marino)}
  .ct-fopts{display:flex;flex-wrap:wrap;gap:8px}
  .ct-fopts.ct-tallas{display:grid;grid-template-columns:repeat(5,1fr)}
  .ct-chip{padding:9px 16px;border-radius:999px;border:1px solid var(--linea);background:#fff;color:var(--marino);font-weight:600;cursor:pointer;font-family:inherit;font-size:.88rem;transition:background .2s,color .2s,border-color .2s}
  .ct-chip:hover{border-color:var(--azul);color:var(--azul)}
  .ct-chip[aria-pressed="true"]{background:var(--azul);border-color:var(--azul);color:#fff}
  .ct-fdone{display:block;margin:0 20px 20px;padding:15px;border:none;border-radius:14px;background:var(--azul);color:#fff;font-family:inherit;font-weight:800;font-size:1rem;cursor:pointer}
  .ct-fdone:hover{background:var(--azul2)}
  .ct-fshade{position:fixed;inset:0;z-index:9340;background:rgba(15,42,71,.45)}
  .ct-fshade[hidden]{display:none}
  .ct-sw{width:28px;height:28px;border-radius:50%;padding:0;border:1px solid rgba(15,42,71,.22);cursor:pointer;background:var(--c);transition:box-shadow .2s}
  .ct-sw[aria-pressed="true"]{box-shadow:0 0 0 2px #fff,0 0 0 4px var(--azul)}
  .ct-sw-blanco{--c:#fff}.ct-sw-negro{--c:#16181d}.ct-sw-gris{--c:#9aa3ad}.ct-sw-azul{--c:#1f5fbf}
  .ct-sw-rosa{--c:linear-gradient(135deg,#f4a7c3 50%,#b9a2e8 50%)}.ct-sw-tierra{--c:linear-gradient(135deg,#a47551 50%,#d8c3a5 50%)}
  .ct-sw-colores{--c:conic-gradient(#e5484d,#f5a524,#46a758,#0b63ce,#8e4ec6,#e5484d)}
  .ct-tf{min-width:36px;height:42px;padding:0 6px;border-radius:10px;border:1px solid var(--linea);background:#fff;color:var(--marino);font-family:inherit;font-weight:700;font-size:.8rem;cursor:pointer}
  .ct-tf[aria-pressed="true"]{background:var(--marino);border-color:var(--marino);color:#fff}
  .ct-tf:disabled{opacity:.35;text-decoration:line-through;cursor:not-allowed}
  .ct-search{position:relative;flex:1 1 auto;min-width:0;margin:0}
  .ct-search svg{position:absolute;left:13px;top:50%;translate:0 -50%;width:18px;height:18px;fill:none;stroke:var(--suave);stroke-width:2;stroke-linecap:round;pointer-events:none}
  .ct-search input{width:100%;padding:10px 14px 10px 40px;border-radius:999px;border:1px solid var(--linea);background:var(--fondo2);font-family:inherit;font-size:.9rem;color:var(--marino)}
  .ct-fbtn svg,.ct-qv svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
  .ct-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:22px;transition:opacity .2s}
  .ct-grid.ct-fading{opacity:.35;transition:opacity .12s}
  .ct-grid[hidden]{display:none}
  .ct-hide{display:none!important}
  .ct-in{animation:ctIn .34s cubic-bezier(.2,.7,.3,1) both}
  @keyframes ctIn{from{opacity:0;scale:.96}to{opacity:1;scale:1}}
  .ct-card{position:relative;background:#fff;border:1px solid var(--linea);border-radius:24px;padding:10px 10px 16px;display:flex;flex-direction:column;cursor:pointer;transition:transform .25s,box-shadow .25s}
