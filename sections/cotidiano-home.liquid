<script>
(function(){
  var hero=document.getElementById('ctHero');
  if(hero){
    var tx=.5,ty=.5,cx=.5,cy=.5,active=false,t0=performance.now();
    var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(function(){hero.classList.remove('ct-intro');},reduce?0:3200);
    hero.addEventListener('pointermove',function(e){var r=hero.getBoundingClientRect();tx=(e.clientX-r.left)/r.width;ty=(e.clientY-r.top)/r.height;active=true;});
    hero.addEventListener('pointerleave',function(){active=false;});
    (function loop(t){
      if(!active&&!reduce){var k=(t-t0)/1000;tx=.5+Math.sin(k*.6)*.18;ty=.5+Math.cos(k*.45)*.14;}
      cx+=(tx-cx)*.08;cy+=(ty-cy)*.08;
      hero.style.setProperty('--mx',cx.toFixed(4));hero.style.setProperty('--my',cy.toFixed(4));
      requestAnimationFrame(loop);
    })(t0);
  }
  /* Ruleta de diseños: arrastre con inercia, flechas, scroll horizontal, inclinación con el mouse y giro solo en reposo */
  var rul=document.getElementById('ctRuleta'),rueda=document.getElementById('ctRueda');
  var rcs=rueda?[].slice.call(rueda.querySelectorAll('.ct-rc')):[];
  if(rul&&rcs.length){
    var rN=rcs.length,rRed=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var paso=2*Math.PI/rN,ang=0,vel=0,meta=null,R=1,arr=false,px=0,pt=0,mov=0,ultimo=-1e9,tX=0,tY=0,iX=0,iY=0,frente=0,rlt=performance.now();
    function medirR(){R=rul.clientWidth*.33||1;}
    medirR();window.addEventListener('resize',medirR);
    function tocarR(){ultimo=performance.now();}
    function pintarR(){
      var best=-2,bi=0;
      for(var i=0;i<rN;i++){
        var t=ang+i*paso,x=Math.sin(t)*R,z=Math.cos(t),d=(z+1)/2,s=.5+.5*Math.pow(d,1.3),c=rcs[i],b=(1-d)*2;
        c.style.transform='translate(-50%,-50%) translate3d('+x.toFixed(1)+'px,0,0) scale('+s.toFixed(3)+')';
        c.style.opacity=(.25+.75*d).toFixed(3);
        c.style.zIndex=Math.round(d*100);
        c.style.filter=b>.05?'blur('+b.toFixed(2)+'px)':'none';
        if(z>best){best=z;bi=i;}
      }
      if(bi!==frente){rcs[frente].classList.remove('front');rcs[bi].classList.add('front');frente=bi;}
    }
    (function giroR(t){
      var f=Math.min((t-rlt)/16.667,3);rlt=t;
      if(!arr){
        if(meta!==null){var dd=meta-ang;if(Math.abs(dd)<.0005){ang=meta;meta=null;}else ang+=dd*(1-Math.pow(.86,f));}
        else if(Math.abs(vel)>.00005){ang+=vel*f;vel*=Math.pow(.94,f);}
        else if(!rRed&&t-ultimo>1500){ang-=.0018*f;}
      }
      if(!rRed){var k=Math.min(1,.08*f);iX+=(tX-iX)*k;iY+=(tY-iY)*k;rueda.style.transform='rotateX('+(iY*-7).toFixed(2)+'deg) rotateY('+(iX*9).toFixed(2)+'deg)';}
      pintarR();
      requestAnimationFrame(giroR);
    })(rlt);
    /* Arrastre: se escucha en window (sin setPointerCapture) para que un toque normal siga abriendo el producto */
    rul.addEventListener('pointerdown',function(e){if(e.button!==0)return;arr=true;meta=null;vel=0;px=e.clientX;pt=performance.now();mov=0;tocarR();rul.classList.add('drag');});
    window.addEventListener('pointermove',function(e){
      if(!arr)return;var now=performance.now(),dx=e.clientX-px,d=dx/R;px=e.clientX;mov+=Math.abs(dx);
      ang+=d;vel=vel*.6+(d/(Math.max(now-pt,1)/16.667))*.4;pt=now;tocarR();
    });
    function soltarR(){if(!arr)return;arr=false;rul.classList.remove('drag');if(rRed||performance.now()-pt>90)vel=0;tocarR();}
    window.addEventListener('pointerup',soltarR);window.addEventListener('pointercancel',soltarR);
    /* Si arrastró más de 6px no abre el producto (los clics de teclado, detail 0, siempre pasan) */
    rul.addEventListener('click',function(e){if(e.detail&&mov>6){e.preventDefault();e.stopPropagation();}mov=0;},true);
    rul.addEventListener('dragstart',function(e){e.preventDefault();});
    rul.addEventListener('wheel',function(e){if(Math.abs(e.deltaX)>Math.abs(e.deltaY)){e.preventDefault();meta=null;vel=0;ang-=e.deltaX/R;tocarR();}},{passive:false});
    rul.addEventListener('pointermove',function(e){if(e.pointerType!=='mouse')return;var r=rul.getBoundingClientRect();tX=(e.clientX-r.left)/r.width-.5;tY=(e.clientY-r.top)/r.height-.5;});
    rul.addEventListener('pointerleave',function(){tX=0;tY=0;});
    function moverR(s){var base=meta!==null?meta:Math.round(ang/paso)*paso;vel=0;meta=base-s*paso;if(rRed){ang=meta;meta=null;}tocarR();}
    var rPrev=document.getElementById('ctRPrev'),rNext=document.getElementById('ctRNext');
    if(rPrev)rPrev.addEventListener('click',function(){moverR(-1);});
    if(rNext)rNext.addEventListener('click',function(){moverR(1);});
  }
  /* Cinta: desplazamiento infinito; el scroll la acelera y su dirección la cambia; hover la frena */
  var cinta=document.getElementById('ctCinta'),track=document.getElementById('ctCintaTrack');
  if(cinta&&track&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    var setW=track.firstElementChild.offsetWidth,cxp=0,dir=-1,boost=0,slow=false,lastY=window.scrollY,lt=performance.now();
    window.addEventListener('resize',function(){setW=track.firstElementChild.offsetWidth;});
    window.addEventListener('scroll',function(){var y=window.scrollY,dy=y-lastY;lastY=y;if(dy){dir=dy>0?-1:1;boost=Math.min(boost+Math.abs(dy)*6,900);}},{passive:true});
    cinta.addEventListener('pointerenter',function(){slow=true;});
    cinta.addEventListener('pointerleave',function(){slow=false;});
    (function run(t){
      var dt=Math.min((t-lt)/1000,.05);lt=t;
      boost*=Math.pow(.93,dt*60);
      cxp+=dir*(55+boost)*(slow?.25:1)*dt;
      if(setW){while(cxp<=-setW)cxp+=setW;while(cxp>0)cxp-=setW;}
      track.style.transform='translate3d('+cxp.toFixed(2)+'px,0,0)';
      requestAnimationFrame(run);
    })(lt);
  }
  /* Notificación "Dicho cotidiano" con voz: aparece a los 7 s, se repite cada 22 s y dura 8 s.
     Cada vez que aparece intenta sonar sola. Los navegadores bloquean el sonido hasta que la persona toca la página:
     si está bloqueado queda el botón .av, y con el primer toque/clic/tecla en cualquier parte se desbloquea y
     desde ahí cada dicho suena solo. No se oculta mientras suena; al terminar se oculta 2.5 s después. La X la apaga por la visita. */
  var dicho=document.getElementById('ctDicho');
  if(dicho){
    var off=false;try{off=sessionStorage.getItem('ctDichoOff')==='1';}catch(e){}
    if(!off){
      var dichos=[
        {t:"Pa'l 24 y pa'l 31 se estrena... ¡así sea las medias!",a:"{{ 'dicho-1.mp3' | asset_url }}"},
        {t:"Uy, ¿y esas zapatillas? ¿Se ganó el chance o qué?",a:"{{ 'dicho-2.mp3' | asset_url }}"},
        {t:"Esas no se prestan... ni al primo.",a:"{{ 'dicho-3.mp3' | asset_url }}"},
        {t:"Mijo, esas son pa' salir, no pa' jugar fútbol.",a:"{{ 'dicho-4.mp3' | asset_url }}"},
        {t:"Guárdelas en la caja, que todavía no es diciembre.",a:"{{ 'dicho-5.mp3' | asset_url }}"},
        {t:"Que el año nuevo lo coja... con pies nuevos.",a:"{{ 'dicho-6.mp3' | asset_url }}"}
      ];
      var dTxt=document.getElementById('ctDichoTxt'),dBtn=document.getElementById('ctDichoPlay'),dHint=dicho.querySelector('.ct-dicho-hint');
      var fi=Math.floor(Math.random()*dichos.length),dHide,dRep,dFirst,voz=new Audio(),desbloqueando=false,vozLista=false;
      /* Sonido automático solo durante los primeros 20 s en la página; después solo suena si la persona toca ▶ */
      var autoHasta=Date.now()+20000,vozAuto=false;
      function autoPermitido(){return Date.now()<autoHasta;}
      setTimeout(function(){if(vozAuto&&!voz.paused)voz.pause();},20000);
      voz.preload='none';
      function sonando(){return !voz.paused&&!voz.ended;}
      function ocultarEn(ms){clearTimeout(dHide);dHide=setTimeout(function(){if(!sonando())dicho.classList.remove('show');},ms);}
      function marcar(on){dBtn.classList.toggle('playing',on);dBtn.setAttribute('aria-label',on?'Pausar el dicho':'Escuchar el dicho');dHint.style.visibility=on?'hidden':'';}
      voz.addEventListener('play',function(){if(desbloqueando)return;marcar(true);clearTimeout(dHide);});
      voz.addEventListener('pause',function(){if(desbloqueando)return;marcar(false);if(!voz.ended)ocultarEn(8000);});
      voz.addEventListener('ended',function(){marcar(false);ocultarEn(2500);});
      voz.addEventListener('error',function(){if(desbloqueando)return;marcar(false);ocultarEn(8000);});
      function reproducir(){
        try{
          desbloqueando=false;voz.muted=false;
          if(voz.getAttribute('src')!==dichos[fi].a){voz.src=dichos[fi].a;}
          var pr=voz.play();if(pr&&pr.catch)pr.catch(function(){marcar(false);}); /* bloqueado o falló: queda el botón, sin error */
        }catch(e){marcar(false);}
      }
      function mostrarDicho(){
        if(sonando())return; /* no cambia la frase mientras suena */
        fi=(fi+1)%dichos.length;dTxt.textContent=dichos[fi].t;
        voz.removeAttribute('src');marcar(false);
        dicho.classList.add('show');ocultarEn(8000);
        if(autoPermitido()){vozAuto=true;reproducir();} /* intenta sonar sola, solo en los primeros 20 s */
      }
      dBtn.addEventListener('click',function(){if(sonando()){voz.pause();}else{vozAuto=false;reproducir();}});
      /* Primer toque/clic/tecla en cualquier parte: desbloquea el audio. Si el dicho está a la vista, suena ya;
         si no, se "estrena" el elemento en silencio (necesario en iPhone) para que los siguientes suenen solos.
         Los toques sobre el botón o la X los manejan sus propios eventos. */
      var evDesbloqueo=['pointerdown','touchend','click','keydown'];
      function desbloquearVoz(e){
        if(vozLista)return;vozLista=true;
        evDesbloqueo.forEach(function(ev){document.removeEventListener(ev,desbloquearVoz,true);});
        if(e.target&&e.target.closest&&e.target.closest('#ctDichoPlay,#ctDichoX'))return;
        if(dicho.classList.contains('show')){if(!sonando()&&autoPermitido()){vozAuto=true;reproducir();}return;}
        try{
          desbloqueando=true;voz.muted=true;voz.src=dichos[(fi+1)%dichos.length].a;
          var p=voz.play(),listo=function(){if(!desbloqueando)return;voz.pause();voz.currentTime=0;voz.muted=false;voz.removeAttribute('src');desbloqueando=false;};
          if(p&&p.then){p.then(listo,listo);}else{listo();}
        }catch(err){voz.muted=false;desbloqueando=false;}
      }
      evDesbloqueo.forEach(function(ev){document.addEventListener(ev,desbloquearVoz,{capture:true,passive:true});});
      dFirst=setTimeout(function(){mostrarDicho();dRep=setInterval(mostrarDicho,22000);},7000);
      document.getElementById('ctDichoX').addEventListener('click',function(){dicho.classList.remove('show');voz.pause();clearTimeout(dFirst);clearTimeout(dHide);clearInterval(dRep);try{sessionStorage.setItem('ctDichoOff','1');}catch(e){}});
    }
  }
  /* ── Heros entre zapatillas (tarjeta y pantalla completa): aparecen al entrar en pantalla y la palabra de fondo se desliza con el scroll ── */
  (function(){
    var hbs=[].slice.call(document.querySelectorAll('.ct-hb,.ct-hb-full,.ct-bfa'));if(!hbs.length)return;
    if(!('IntersectionObserver' in window)){hbs.forEach(function(h){h.classList.add('vis');});return;}
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('vis');io.unobserve(e.target);}});},{threshold:.25});
    hbs.forEach(function(h){io.observe(h);});
    /* Videos de los heros: se cargan y reproducen solo cuando están en pantalla (el de celular o el de computador, según el ancho) */
    var vids=[].slice.call(document.querySelectorAll('.ct-hb-vid video'));
    if(vids.length){var vio=new IntersectionObserver(function(es){es.forEach(function(e){var v=e.target;if(e.isIntersecting){if(v.preload==='none')v.preload='auto';var p=v.play();if(p&&p.catch)p.catch(function(){});}else v.pause();});},{threshold:.1});vids.forEach(function(v){vio.observe(v);});}
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    var words=hbs.map(function(h){return h.querySelector('.ct-hb-word');}).filter(Boolean),raf=0;
    if(!words.length)return;
    function mover(){raf=0;var vh=window.innerHeight;words.forEach(function(w){var r=w.parentNode.getBoundingClientRect();if(0>r.bottom||r.top>vh)return;var p=(r.top+r.height/2-vh/2)/vh;w.style.setProperty('--hbx',Math.round(p*120)+'px');});}
    window.addEventListener('scroll',function(){if(!raf)raf=requestAnimationFrame(mover);},{passive:true});mover();
  })();
  /* ── Black Friday animado: cuenta regresiva y fotos que se mueven con el scroll ── */
  (function(){
    var bfs=[].slice.call(document.querySelectorAll('.ct-bfa'));if(!bfs.length)return;
    function dos(n){return (n<10?'0':'')+n;}
    bfs.forEach(function(b){
      var cd=b.querySelector('.ct-bfa-cd');if(!cd)return;
      /* "2026-11-30 23:59" se toma como hora de Colombia (UTC-5) */
      var raw=(cd.dataset.fin||'').trim().replace(' ','T');if(raw.length===16)raw+=':00';
      var fin=Date.parse(/[zZ]|[+-]\d\d:\d\d$/.test(raw)?raw:raw+'-05:00');if(isNaN(fin))return;
      var u={};['d','h','m','s'].forEach(function(k){u[k]=cd.querySelector('[data-u="'+k+'"]');});
      function tick(){var r=Math.floor((fin-Date.now())/1000);if(0>=r){cd.hidden=true;clearInterval(t);return;}cd.hidden=false;
        u.d.textContent=dos(Math.floor(r/86400));u.h.textContent=dos(Math.floor(r%86400/3600));u.m.textContent=dos(Math.floor(r%3600/60));u.s.textContent=dos(r%60);}
      var t=setInterval(tick,1000);tick();
    });
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    var raf=0;
    function mover(){raf=0;var vh=window.innerHeight;bfs.forEach(function(b){var r=b.getBoundingClientRect();if(0>r.bottom||r.top>vh)return;var p=(r.top+r.height/2-vh/2)/vh;b.style.setProperty('--bfp',p.toFixed(3));});}
    window.addEventListener('scroll',function(){if(!raf)raf=requestAnimationFrame(mover);},{passive:true});mover();
  })();
  /* ── Colección ── */
  var grid=document.getElementById('ctGrid');
  var RM=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var DATA={};try{JSON.parse(document.getElementById('ctData').textContent).forEach(function(p){DATA[p.h]=p;});}catch(e){}
  var MV=[];try{MV=JSON.parse(document.getElementById('ctMV').textContent);}catch(e){}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function norm(s){return String(s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'');}
  var F={marca:'',genero:'',estilo:'',color:'',talla:'',q:'',orden:'dest'};
  var aplicar=function(){};
  if(grid){
    var cards=[].slice.call(grid.querySelectorAll('.ct-it')),frs=[].slice.call(grid.querySelectorAll('.ct-slot'));
    var fzone=document.getElementById('ct-coleccion'),elAct=document.getElementById('ctAct'),elActChips=document.getElementById('ctActChips');
