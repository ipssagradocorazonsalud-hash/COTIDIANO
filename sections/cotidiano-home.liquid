          var hero=document.getElementById('ctHero'),snow=document.getElementById('ctSnow'),svg=document.getElementById('ctLights');
          if(!hero||!snow||!svg)return;
          var n=window.matchMedia('(max-width:700px)').matches?35:70,html='';
          for(var i=0;i<n;i++){
            var d=8+Math.random()*10;
            html+='<i style="--x:'+(Math.random()*100).toFixed(2)+'%;--y:'+(Math.random()*100).toFixed(2)+'%;--s:'+(2+Math.random()*4).toFixed(1)+'px;--o:'+(.3+Math.random()*.6).toFixed(2)+';--d:'+d.toFixed(2)+'s;--dl:-'+(Math.random()*d).toFixed(2)+'s;--dx:'+Math.round(Math.random()*120-60)+'px"></i>';
          }
          snow.innerHTML=html;
          var colores=['#7CC4FF','#FFFFFF','#FFD36E'];
          function medir(){
            var H=hero.offsetHeight;snow.style.setProperty('--h',Math.round(H*1.1+10)+'px');
            var W=Math.max(svg.clientWidth,1),P=110,d='M0 8',c='';
            svg.setAttribute('viewBox','0 0 '+W+' 60');
            for(var x=0;x<W;x+=P)d+=' Q'+(x+P/2)+' 34 '+(x+P)+' 8';
            for(var k=0,bx=0;bx<=W;k++,bx+=55){
              var cy=(k%2?21:8)+7;
              c+='<circle class="b'+(k%4)+'" cx="'+bx+'" cy="'+cy+'" r="5" fill="'+colores[k%3]+'"/>';
            }
            svg.innerHTML='<path d="'+d+'"/>'+c;
          }
          medir();
          var t;window.addEventListener('resize',function(){clearTimeout(t);t=setTimeout(medir,150);});
        }
        if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',iniciar);else iniciar();
      })();
      </script>
    {%- endif -%}
