    var elCount=document.getElementById('ctCount'),elCount2=document.getElementById('ctCount2'),elClear=document.getElementById('ctClear'),elEmpty=document.getElementById('ctEmpty'),elFNum=document.getElementById('ctFNum'),elQ=document.getElementById('ctQ'),elSort=document.getElementById('ctSort');
