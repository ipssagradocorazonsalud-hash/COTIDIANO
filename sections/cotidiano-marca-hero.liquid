{%- comment -%}
  COTIDIANO® · Portada de marca (plantilla templates/collection.marca.json).
  Va arriba de la grilla de productos de Shopify (filtros y orden incluidos).
  Muestra: volver al Universo de Marcas, imagen de la marca, logo, título, texto editorial
  (la descripción de la colección o el texto del ajuste) y accesos rápidos.
  La imagen y el logo salen de los archivos del tema según el handle de la colección
  (rt-marca-{handle}.webp y logo-{handle}-oscuro.png); se pueden reemplazar desde el editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign c = collection
  assign h = c.handle
  assign hm = h
  if h == 'on-running'
    assign hm = 'on'
  endif
  assign marcas_tema = ',adidas,nike,new-balance,on,salomon,ugg,'
  assign lk = ',' | append: hm | append: ','
  assign texto = c.description | strip_html | strip
  if texto == blank
    assign texto = s.texto | default: 'Explora los modelos disponibles de esta marca en COTIDIANO.'
  endif
-%}

<div class="rt rt-mh">
  <div class="rt-wrap">
    <nav class="rt-mh-nav" aria-label="Ruta">
      <a href="{{ routes.root_url }}#rtUni"><span aria-hidden="true">←</span> {{ s.volver | escape }}</a>
    </nav>
    <div class="rt-mh-grid">
      <div class="rt-mh-media">
        {%- if s.imagen -%}
          {{ s.imagen | image_url: width: 900 | image_tag: alt: c.title, loading: 'eager', fetchpriority: 'high', widths: '400, 600, 900', sizes: '(max-width: 760px) 70vw, 360px' }}
        {%- elsif marcas_tema contains lk -%}
          <img src="{{ 'rt-marca-' | append: hm | append: '.webp' | asset_url }}" alt="{{ c.title | escape }}" width="318" height="369" fetchpriority="high">
        {%- elsif c.image -%}
          {{ c.image | image_url: width: 900 | image_tag: alt: c.title, loading: 'eager', widths: '400, 600, 900', sizes: '(max-width: 760px) 70vw, 360px' }}
        {%- endif -%}
      </div>
      <div class="rt-mh-txt">
        <p class="rt-kicker rt-kicker-l"><span>{{ s.kicker | escape }}</span></p>
        {%- if s.logo -%}
          {{ s.logo | image_url: height: 160 | image_tag: alt: c.title, class: 'rt-mh-logo' }}
        {%- elsif marcas_tema contains lk -%}
          <img class="rt-mh-logo" src="{{ 'logo-' | append: hm | append: '-oscuro.png' | asset_url }}" alt="" aria-hidden="true" height="80">
        {%- endif -%}
        <h1 class="rt-h2 rt-serif rt-mh-t">{{ c.title | escape }}</h1>
        <p class="rt-mh-p">{{ texto | escape }}</p>
        {%- liquid
          assign total = 0
          for p in c.products limit: 48
            assign n = 1
            for o in p.options_with_values
              assign on = o.name | downcase
              if on contains 'color'
                assign n = o.values.size
              endif
            endfor
            assign total = total | plus: n
          endfor
        -%}
        <p class="rt-mh-n">{{ total }} {% if total == 1 %}modelo disponible{% else %}modelos disponibles{% endif %}</p>
        <div class="rt-mh-cta">
          <a class="rt-btn rt-btn-dark" href="#rtMhGrid">Ver modelos <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </div>
  <span id="rtMhGrid" class="rt-mh-anchor" aria-hidden="true"></span>
</div>

{% schema %}
{
  "name": "Portada de marca",
  "class": "rt-mh-sec",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño superior", "default": "Universo de Marcas" },
    { "type": "text", "id": "volver", "label": "Texto para volver", "default": "Volver a las marcas" },
    { "type": "textarea", "id": "texto", "label": "Texto si la colección no tiene descripción", "default": "Explora los modelos disponibles de esta marca en COTIDIANO." },
    { "type": "image_picker", "id": "imagen", "label": "Imagen (opcional)" },
    { "type": "image_picker", "id": "logo", "label": "Logo (opcional)" }
  ],
  "presets": [{ "name": "Portada de marca" }]
}
{% endschema %}
